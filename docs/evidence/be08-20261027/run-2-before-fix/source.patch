+  if (governorTimelock[0].toLowerCase() !== timelock.address || governorTreasury[0].toLowerCase() !== treasury.address) {
+    fail('BE06_CONTRACT_LINK_MISMATCH', 'Governor timelock/Treasury linkage differs from the manifest at H.');
