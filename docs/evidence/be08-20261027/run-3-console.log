    685  |+
    686  |+    // Mutate exactly one hash input, leaving the created proposal's identity unchanged.
    687  |+    function _tamper(uint256 field) internal returns (bytes32 hash) {
    688  |+        hash = _descriptionHash();
    689  |+        if (field == 0) calldatas[0] = abi.encodeCall(ITreasury.disburse, (REQUEST, outsider, 1_000 ether));
    690  |+        if (field == 1) calldatas[0] = abi.encodeCall(ITreasury.disburse, (REQUEST, recipient, 999 ether));
    691  |+        if (field == 2) hash = keccak256("different description");
    692  |+    }
    693  |+
    694  |+    function _queueTampering(uint256 field) internal {
    695  |+        uint256 id = _successful();
    696  |+        bytes32 originalOperation = _operation(_descriptionHash());
    697  |+        bytes32 hash = _tamper(field);
    698  |+        uint256 altered = governor.hashProposal(targets, values, calldatas, hash);
    699  |+        assertTrue(id != altered);
    700  |+        vm.expectRevert(abi.encodeWithSelector(IGovernor.GovernorNonexistentProposal.selector, altered));
    701  |+        governor.queue(targets, values, calldatas, hash);
    702  |+        _assertUnpaid(id, IGovernor.ProposalState.Succeeded);
    703  |+        assertFalse(timelock.isOperation(originalOperation));
    704  |+        assertFalse(timelock.isOperation(_operation(hash)));
    705  |+    }
