[stdout]     112  |+/// @notice Independent TV4 Treasury accounting/authorization scope only.
[stdout]     113  |+/// @dev Not full INV01-INV04 or governance acceptance. Uses profile.ci's 100 x 50 campaign.
[stdout]     114  |+contract TreasuryAccountingInvariantTest is Test {
[stdout]     115  |+    TreasuryAccountingHandler internal handler;
[stdout]     116  |+    BudgetToken internal token;
[stdout]     117  |+    Treasury internal treasury;
[stdout]     118  |+
[stdout]     119  |+    function setUp() public {
[stdout]     120  |+        handler = new TreasuryAccountingHandler();
[stdout]     121  |+        token = handler.token();
[stdout]     122  |+        treasury = handler.treasury();
[stdout]     123  |+
[stdout]     124  |+        // Every campaign starts with a genuine successful payment, not merely a
[stdout]     125  |+        // conditional invariant over an unreachable successful-payment branch.
[stdout]     126  |+        handler.fund(1_000 ether);
[stdout]     127  |+        handler.changeRole(0, 0);
[stdout]     128  |+        handler.pay(0, 0, 0, 100 ether);
[stdout]     129  |+        assertEq(handler.successfulPayments(), 1);
[stdout]     130  |+        assertEq(token.balanceOf(handler.recipient(0)), 100 ether);
[stdout]     131  |+
[stdout]     132  |+        bytes4[] memory selectors = new bytes4[](4);
[stdout]     133  |+        selectors[0] = TreasuryAccountingHandler.fund.selector;
[stdout]     134  |+        selectors[1] = TreasuryAccountingHandler.changeRole.selector;
[stdout]     135  |+        selectors[2] = TreasuryAccountingHandler.pay.selector;
[stdout]     136  |+        selectors[3] = TreasuryAccountingHandler.payAvailable.selector;
[stdout]     137  |+        targetContract(address(handler));
[stdout]     138  |+        targetSelector(FuzzSelector({addr: address(handler), selectors: selectors}));
[stdout]     139  |+    }
[stdout]     140  |+
[stdout]     141  |+    function invariant_accountingMatchesSuccessfulPaymentOracle() public view {
[stdout]     142  |+        uint256 recipientBalances;
[stdout]     143  |+        uint256 oracleReceived;
[stdout]     144  |+        for (uint256 i; i < handler.RECIPIENT_COUNT(); ++i) {
[stdout]     145  |+            uint256 balance = token.balanceOf(handler.recipient(i));
[stdout]     146  |+            assertEq(balance, handler.received(i), "recipient differs from successful-payment oracle");
[stdout]     147  |+            recipientBalances += balance;
[stdout]     148  |+            oracleReceived += handler.received(i);
[stdout]     149  |+        }
[stdout]     150  |+        assertEq(oracleReceived, handler.totalPaid());
[stdout]     151  |+        assertEq(token.balanceOf(address(treasury)) + handler.totalPaid(), handler.totalFunded());
[stdout]     152  |+        assertEq(token.balanceOf(address(handler)) + handler.totalFunded(), 20_000 ether);
[stdout]     153  |+        assertEq(
[stdout]     154  |+            token.balanceOf(address(handler)) + token.balanceOf(address(treasury)) + recipientBalances, 20_000 ether
[stdout]     155  |+        );
[stdout]     156  |+        assertEq(token.totalSupply(), 20_000 ether);
[stdout]     157  |+    }
[stdout]     158  |+
[stdout]     159  |+    function invariant_eachRequestSucceedsAtMostOnceAcrossRoleEpochs() public view {
[stdout]     160  |+        uint256 payments;
[stdout]     161  |+        for (uint256 i; i < handler.REQUEST_COUNT(); ++i) {
[stdout]     162  |+            uint256 count = handler.successfulPaymentsByRequest(i);
[stdout]     163  |+            assertLe(count, 1, "request succeeded twice");
[stdout]     164  |+            assertEq(treasury.paidRequests(bytes32(i)), count == 1, "paid flag differs from independent history");
[stdout]     165  |+            payments += count;
[stdout]     166  |+        }
[stdout]     167  |+        assertEq(payments, handler.successfulPayments());
[stdout]     168  |+        assertGe(payments, 1, "campaign must include a real payment");
[stdout]     169  |+    }
[stdout]     170  |+
[stdout]     171  |+    function invariant_onlyCurrentlyAuthorizedActorsCanPay() public view {
