    663  |+
    664  |+    function _operation(bytes32 hash) internal view returns (bytes32) {
    665  |+        return
    666  |+            timelock.hashOperationBatch(
    667  |+                targets, values, calldatas, bytes32(0), bytes32(bytes20(address(governor))) ^ hash
    668  |+            );
    669  |+    }
