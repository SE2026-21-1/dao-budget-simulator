    719  |+    function _executeTampering(uint256 field) internal {
    720  |+        (uint256 id, bytes32 operation) = _queueSuccessful();
    721  |+        bytes32 hash = _tamper(field);
    722  |+        uint256 altered = governor.hashProposal(targets, values, calldatas, hash);
    723  |+        assertTrue(id != altered);
    724  |+        vm.expectRevert(abi.encodeWithSelector(IGovernor.GovernorNonexistentProposal.selector, altered));
    725  |+        governor.execute(targets, values, calldatas, hash);
    726  |+        _assertUnpaid(id, IGovernor.ProposalState.Queued);
    727  |+        assertTrue(timelock.isOperationReady(operation));
    728  |+        assertFalse(timelock.isOperationDone(operation));
    729  |+    }
