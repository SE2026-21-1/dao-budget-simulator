    62   |+    address internal admin = makeAddr("bootstrapAdmin");
    63   |+    address internal timelock = makeAddr("mockTimelock");
    64   |+    address internal holder = makeAddr("fundingWallet");
    65   |+    address internal recipient = makeAddr("recipient");
    66   |+    address internal outsider = makeAddr("outsider");
    67   |+    bytes32 internal constant REQUEST = keccak256("request-1");
