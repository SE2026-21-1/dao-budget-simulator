    78   |+        _pay(actorSeed, requestSeed, recipientSeed, bound(amountSeed, 1, totalFunded - totalPaid));
    79   |+    }
    80   |+
    81   |+    function _pay(uint256 actorSeed, uint256 requestSeed, uint256 recipientSeed, uint256 amount) internal {
    82   |+        uint256 callerIndex = actorSeed % ACTOR_COUNT;
    83   |+        uint256 requestIndex = requestSeed % REQUEST_COUNT;
    84   |+        uint256 recipientIndex = recipientSeed % RECIPIENT_COUNT;
    85   |+        bool authorized = expectedSpender[callerIndex];
    86   |+        // This prediction never reads Treasury.paidRequests or Treasury's balance.
    87   |+        bool shouldSucceed = authorized && successfulPaymentsByRequest[requestIndex] == 0 && amount > 0
    88   |+            && totalPaid <= totalFunded && amount <= totalFunded - totalPaid;
    89   |+
    90   |+        vm.prank(actor(callerIndex));
    91   |+        (bool success,) = address(treasury)
    92   |+            .call(abi.encodeCall(ITreasury.disburse, (bytes32(requestIndex), recipient(recipientIndex), amount)));
    93   |+
    94   |+        // Sticky evidence survives subsequent calls and does not depend on the
    95   |+        // invariant runner's fail_on_revert setting to retain a failed assertion.
    96   |+        if (success != shouldSucceed) unexpectedOutcome = true;
    97   |+        if (!authorized) {
    98   |+            unauthorizedAttempts++;
    99   |+            if (success) unauthorizedSuccesses++;
    100  |+        }
    101  |+        if (success) {
    102  |+            successfulPaymentsByRequest[requestIndex]++;
    103  |+            received[recipientIndex] += amount;
    104  |+            totalPaid += amount;
    105  |+            successfulPayments++;
    106  |+        } else {
    107  |+            rejectedPayments++;
    108  |+        }
    109  |+    }
    110  |+}
    111  |+
    112  |+/// @notice Independent TV4 Treasury accounting/authorization scope only.
    113  |+/// @dev Not full INV01-INV04 or governance acceptance. Uses profile.ci's 100 x 50 campaign.
    114  |+contract TreasuryAccountingInvariantTest is Test {
    115  |+    TreasuryAccountingHandler internal handler;
    116  |+    BudgetToken internal token;
    117  |+    Treasury internal treasury;
    118  |+
    119  |+    function setUp() public {
    120  |+        handler = new TreasuryAccountingHandler();
    121  |+        token = handler.token();
    122  |+        treasury = handler.treasury();
    123  |+
    124  |+        // Every campaign starts with a genuine successful payment, not merely a
    125  |+        // conditional invariant over an unreachable successful-payment branch.
    126  |+        handler.fund(1_000 ether);
    127  |+        handler.changeRole(0, 0);
    128  |+        handler.pay(0, 0, 0, 100 ether);
    129  |+        assertEq(handler.successfulPayments(), 1);
    130  |+        assertEq(token.balanceOf(handler.recipient(0)), 100 ether);
    131  |+
    132  |+        bytes4[] memory selectors = new bytes4[](4);
    133  |+        selectors[0] = TreasuryAccountingHandler.fund.selector;
    134  |+        selectors[1] = TreasuryAccountingHandler.changeRole.selector;
    135  |+        selectors[2] = TreasuryAccountingHandler.pay.selector;
    136  |+        selectors[3] = TreasuryAccountingHandler.payAvailable.selector;
    137  |+        targetContract(address(handler));
    138  |+        targetSelector(FuzzSelector({addr: address(handler), selectors: selectors}));
    139  |+    }
    140  |+
    141  |+    function invariant_accountingMatchesSuccessfulPaymentOracle() public view {
    142  |+        uint256 recipientBalances;
    143  |+        uint256 oracleReceived;
    144  |+        for (uint256 i; i < handler.RECIPIENT_COUNT(); ++i) {
    145  |+            uint256 balance = token.balanceOf(handler.recipient(i));
    146  |+            assertEq(balance, handler.received(i), "recipient differs from successful-payment oracle");
    147  |+            recipientBalances += balance;
    148  |+            oracleReceived += handler.received(i);
    149  |+        }
    150  |+        assertEq(oracleReceived, handler.totalPaid());
    151  |+        assertEq(token.balanceOf(address(treasury)) + handler.totalPaid(), handler.totalFunded());
    152  |+        assertEq(token.balanceOf(address(handler)) + handler.totalFunded(), 20_000 ether);
    153  |+        assertEq(
    154  |+            token.balanceOf(address(handler)) + token.balanceOf(address(treasury)) + recipientBalances, 20_000 ether
    155  |+        );
    156  |+        assertEq(token.totalSupply(), 20_000 ether);
    157  |+    }
    158  |+
    159  |+    function invariant_eachRequestSucceedsAtMostOnceAcrossRoleEpochs() public view {
    160  |+        uint256 payments;
    161  |+        for (uint256 i; i < handler.REQUEST_COUNT(); ++i) {
    162  |+            uint256 count = handler.successfulPaymentsByRequest(i);
    163  |+            assertLe(count, 1, "request succeeded twice");
    164  |+            assertEq(treasury.paidRequests(bytes32(i)), count == 1, "paid flag differs from independent history");
    165  |+            payments += count;
    166  |+        }
    167  |+        assertEq(payments, handler.successfulPayments());
    168  |+        assertGe(payments, 1, "campaign must include a real payment");
    169  |+    }
    170  |+
    171  |+    function invariant_onlyCurrentlyAuthorizedActorsCanPay() public view {
    172  |+        assertFalse(handler.unexpectedOutcome(), "payment result differs from authorization/accounting model");
    173  |+        assertEq(handler.unauthorizedSuccesses(), 0, "unprivileged or revoked caller paid");
    174  |+        for (uint256 i; i < handler.ACTOR_COUNT(); ++i) {
    175  |+            assertEq(treasury.hasRole(treasury.SPENDER_ROLE(), handler.actor(i)), handler.expectedSpender(i));
    176  |+            assertFalse(treasury.hasRole(treasury.DEFAULT_ADMIN_ROLE(), handler.actor(i)));
    177  |+            assertEq(token.balanceOf(handler.actor(i)), 0, "BUD escaped recipient universe");
    178  |+        }
    179  |+    }
    180  |+
    181  |+    function testPendingRequestSurvivesFundingAndSpenderEpochsWithoutReplay() public {
    182  |+        // Request 1 first fails authorization, then funding, then revocation.
    183  |+        handler.pay(1, 1, 1, 100 ether);
    184  |+        handler.changeRole(1, 0);
    185  |+        handler.pay(1, 1, 1, 1_000 ether);
    186  |+        handler.changeRole(1, 1);
    187  |+        handler.fund(1_000 ether);
    188  |+        handler.pay(1, 1, 2, 1_000 ether);
    189  |+        assertEq(handler.successfulPaymentsByRequest(1), 0);
    190  |+        assertFalse(treasury.paidRequests(bytes32(uint256(1))));
    191  |+
    192  |+        // A different authorized actor can execute that still-pending ID.
    193  |+        handler.changeRole(2, 0);
    194  |+        handler.pay(2, 1, 2, 1_000 ether);
    195  |+        handler.changeRole(2, 2);
    196  |+        handler.pay(2, 2, 3, 100 ether);
    197  |+        handler.changeRole(1, 0);
    198  |+        // Re-granting a former spender cannot replay another spender's payment.
    199  |+        handler.pay(1, 1, 3, 50 ether);
    200  |+        handler.pay(1, 2, 3, 900 ether);
    201  |+
    202  |+        assertEq(handler.successfulPayments(), 3);
    203  |+        assertEq(handler.rejectedPayments(), 5);
    204  |+        assertEq(handler.unauthorizedAttempts(), 3);
    205  |+        assertEq(handler.totalFunded(), 2_000 ether);
    206  |+        assertEq(handler.totalPaid(), 2_000 ether);
    207  |+        assertEq(token.balanceOf(handler.recipient(0)), 100 ether);
    208  |+        assertEq(token.balanceOf(handler.recipient(1)), 0);
    209  |+        assertEq(token.balanceOf(handler.recipient(2)), 1_000 ether);
    210  |+        assertEq(token.balanceOf(handler.recipient(3)), 900 ether);
    211  |+        assertEq(token.balanceOf(address(treasury)), 0);
    212  |+        invariant_accountingMatchesSuccessfulPaymentOracle();
    213  |+        invariant_eachRequestSucceedsAtMostOnceAcrossRoleEpochs();
    214  |+        invariant_onlyCurrentlyAuthorizedActorsCanPay();
    215  |+    }
    216  |+}

