    1075 |+        assertGe(gov.getPastVotes(b, governor.clock() - 1), 50 ether);
    1076 |+        uint256 first = _create();
    1077 |+        uint256 copied = governor.hashProposal(targets, values, calldatas, _descriptionHash());
    1078 |+        assertEq(first, copied);
    1079 |+        vm.expectRevert(
    1080 |+            abi.encodeWithSelector(
    1081 |+                IGovernor.GovernorUnexpectedProposalState.selector, first, IGovernor.ProposalState.Pending, bytes32(0)
    1082 |+            )
    1083 |+        );
    1084 |+        vm.prank(b);
    1085 |+        governor.propose(targets, values, calldatas, DESCRIPTION);
    1086 |+        assertEq(governor.proposalProposer(first), a);
    1087 |+        vm.expectRevert(abi.encodeWithSelector(IGovernor.GovernorUnableToCancel.selector, first, b));
    1088 |+        vm.prank(b);
    1089 |+        governor.cancel(targets, values, calldatas, _descriptionHash());
    1090 |+        _state(first, IGovernor.ProposalState.Pending);
    1091 |+        vm.prank(a);
    1092 |+        governor.cancel(targets, values, calldatas, _descriptionHash());
    1093 |+        _state(first, IGovernor.ProposalState.Canceled);
    1094 |+        assertEq(governor.proposalProposer(first), a);
    1095 |+        assertFalse(treasury.paidRequests(REQUEST));
    1096 |+        assertEq(bud.balanceOf(address(treasury)), 10_000 ether);
    1097 |+    }
    1098 |+}

