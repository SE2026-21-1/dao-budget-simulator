+    function testZeroAmountReverts() public {
+        vm.expectRevert(abi.encodeWithSelector(Treasury.InvalidAmount.selector, uint256(0)));
+        _pay(REQUEST, recipient, 0);
+        assertFalse(treasury.paidRequests(REQUEST));
