# API TV2 is the default data source. Set VITE_DATA_SOURCE=fixture only for an offline demo.
# Copy to .env.local and fill chain/deployment from a real manifest for API reads.
# Add RPC and contract addresses from the same manifest to enable wallet transactions.
# API_CORS_ORIGINS on the server must include the exact Vite origin.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_DEPLOYMENT_ID=
VITE_CHAIN_ID=
VITE_CHAIN_NAME=
VITE_RPC_URL=
VITE_GOVERNOR_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_TIMELOCK_ADDRESS=
VITE_GOV_TOKEN_ADDRESS=
VITE_BUD_TOKEN_ADDRESS=
VITE_EXPLORER_URL=
