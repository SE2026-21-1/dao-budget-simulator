    10   |+contract Treasury is ITreasury, AccessControl {
    11   |+    using SafeERC20 for IERC20;
    12   |+
    13   |+    bytes32 public constant SPENDER_ROLE = keccak256("SPENDER_ROLE");
    14   |+    IERC20 public immutable budgetToken;
    15   |+    mapping(bytes32 requestId => bool paid) public paidRequests;
    16   |+
    17   |+    error InvalidBudgetToken(address token);
    18   |+    error InvalidAdmin(address admin);
    19   |+    error InvalidRecipient(address recipient);
    20   |+    error InvalidAmount(uint256 amount);
    21   |+    error RequestAlreadyPaid(bytes32 requestId);
    22   |+    error InsufficientBudget(uint256 available, uint256 required);
    23   |+
    24   |+    /// @param token Deployed BUD contract; immutable for this Treasury.
    25   |+    /// @param initialAdmin Bootstrap administrator, without automatic spending authority.
    26   |+    constructor(address token, address initialAdmin) {
    27   |+        if (token.code.length == 0) revert InvalidBudgetToken(token);
    28   |+        if (initialAdmin == address(0)) revert InvalidAdmin(initialAdmin);
    29   |+        budgetToken = IERC20(token);
