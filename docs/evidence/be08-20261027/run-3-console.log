    16   |+    }
    17   |+
    18   |+    function testConcurrentSnapshotsBudgetRaceRetryAndSharedRequestStayIndependent() public {
    19   |+        // Reachability control runs inside an action, not in fixture deployment.
    20   |+        // Request 0 pays 1 BUD; 9,999 BUD remains and no bootstrap role remains.
    21   |+        handler.advance(0);
    22   |+        assertEq(handler.successfulExecutions(), 1);
    23   |+        assertEq(handler.bud().balanceOf(address(handler.treasury())), 9_999 ether);
    24   |+
    25   |+        handler.propose(0, 1, 0, 7_000 ether);
    26   |+        GovernanceOracleHandler.Proposal memory first = handler.proposal(1);
    27   |+        handler.advance(first.snapshot + 1 - block.timestamp);
    28   |+
    29   |+        // A's 400 tokens and B's 300 delegated votes now belong to actor 4.
    30   |+        // This must affect later snapshots, but cannot rewrite the first one.
    31   |+        handler.transferGov(0, 4, 400 ether);
    32   |+        handler.delegateGov(1, 4);
    33   |+        handler.advance(1);
    34   |+        handler.propose(4, 2, 1, 6_000 ether);
    35   |+        handler.propose(4, 2, 2, 2_000 ether);
    36   |+        GovernanceOracleHandler.Proposal memory second = handler.proposal(2);
    37   |+        GovernanceOracleHandler.Proposal memory competing = handler.proposal(3);
    38   |+        assertGt(second.snapshot, first.snapshot);
    39   |+        assertTrue(first.id != second.id && second.id != competing.id);
    40   |+        assertTrue(second.operation != competing.operation);
    41   |+        assertEq(second.request, competing.request);
    42   |+
    43   |+        handler.advance(second.snapshot + 1 - block.timestamp);
    44   |+        // After both later snapshots, remove all of actor 4's current power.
    45   |+        // Its historical 700 votes must nevertheless remain valid in BOTH.
    46   |+        handler.delegateGov(4, handler.ACTOR_COUNT());
    47   |+        handler.delegateGov(1, 1);
    48   |+        handler.approveGov(4, 3, 400 ether);
    49   |+        handler.transferFromGov(4, 3, 2, 400 ether);
    50   |+        assertEq(handler.allowances(4, 3), 0);
    51   |+        // A different funded owner gave this spender no approval: the denied
    52   |+        // transfer cannot rewrite either proposal's already pinned snapshot.
    53   |+        uint256 delegatedFailures = handler.reverts(uint256(GovernanceOracleHandler.CallKind.TransferFrom));
    54   |+        handler.transferFromGov(2, 3, 4, 1 ether);
    55   |+        assertEq(handler.reverts(uint256(GovernanceOracleHandler.CallKind.TransferFrom)), delegatedFailures + 1);
    56   |+        handler.vote(1, 0, 1);
    57   |+        handler.vote(1, 1, 1);
    58   |+        handler.vote(2, 4, 1);
    59   |+        handler.vote(3, 4, 1);
    60   |+        // A's vote cannot be reused after tokens were moved to the later voter.
    61   |+        handler.vote(1, 4, 1); // Zero weight at the first snapshot.
    62   |+        handler.vote(2, 0, 1); // Zero weight at the second snapshot.
    63   |+        handler.vote(2, 4, 0); // Duplicate rejected, original For remains.
    64   |+
    65   |+        first = handler.proposal(1);
    66   |+        second = handler.proposal(2);
    67   |+        assertEq(first.weights[0], 400 ether);
    68   |+        assertEq(first.weights[1], 300 ether);
    69   |+        assertEq(first.weights[4], 0);
    70   |+        assertEq(second.weights[0], 0);
    71   |+        assertEq(second.weights[1], 0);
    72   |+        assertEq(second.weights[4], 700 ether);
