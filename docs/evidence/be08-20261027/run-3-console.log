    671  |+    function _queueSuccessful() internal returns (uint256 id, bytes32 operation) {
    672  |+        id = _successful();
    673  |+        governor.queue(targets, values, calldatas, _descriptionHash());
    674  |+        operation = _operation(_descriptionHash());
