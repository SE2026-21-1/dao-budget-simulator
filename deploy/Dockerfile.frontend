# syntax=docker/dockerfile:1
FROM node:24.15.0-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend
COPY frontend ./frontend
COPY fixtures/api ./fixtures/api
COPY fixtures/sc01/disbursement-v1.json ./fixtures/sc01/disbursement-v1.json
COPY shared/abi/TimelockController.json ./shared/abi/TimelockController.json
# The deployed bundle refuses local fixture defaults if runtime configuration is absent.
ENV VITE_CONTAINER_RUNTIME=1
RUN npm run build --prefix frontend

FROM node:24.15.0-bookworm-slim AS frontend
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/frontend/dist ./public
COPY scripts/cd/container-frontend.mjs ./server.mjs
USER node
EXPOSE 8080
STOPSIGNAL SIGTERM
CMD ["node", "server.mjs"]
