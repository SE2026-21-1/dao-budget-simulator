    951  |+    function _signBallot(uint256 key, bytes32 structHash) internal view returns (bytes memory) {
    952  |+        bytes32 domain = keccak256(
    953  |+            abi.encode(
    954  |+                keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
    955  |+                keccak256(bytes(governor.name())),
    956  |+                keccak256(bytes(governor.version())),
    957  |+                block.chainid,
    958  |+                address(governor)
    959  |+            )
    960  |+        );
    961  |+        (uint8 v, bytes32 r, bytes32 sigS) = vm.sign(key, keccak256(abi.encodePacked(hex"1901", domain, structHash)));
    962  |+        return abi.encodePacked(r, sigS, v);
    963  |+    }
