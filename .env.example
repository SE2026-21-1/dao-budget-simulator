# Set these environment variables before invoking the CLI; no automatic .env loading.
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgresql://be02_demo@127.0.0.1:5432/be02_demo
API_HOST=127.0.0.1
API_PORT=3000
# Replace with a stable randomly generated value of at least 32 bytes.
API_CURSOR_SECRET=replace-this-with-at-least-32-random-bytes-before-running
API_SNAPSHOT_TTL_SECONDS=900
# Optional comma-separated exact browser origins; leave empty when not needed.
API_CORS_ORIGINS=
