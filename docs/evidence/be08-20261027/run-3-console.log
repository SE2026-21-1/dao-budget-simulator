833      |-        emit log_named_uint("unassisted execute successes", handler.spontaneousExecutions());
834      |-        emit log_named_uint("execute reverts", handler.reverts(uint256(GovernanceOracleHandler.CallKind.Execute)));
835      |-        emit log_named_uint("vote successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Vote)));
836      |-        emit log_named_uint("queue successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Queue)));
837      |-        emit log_named_uint("cancel successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Cancel)));
838      |-        emit log_named_uint(
