+      block: options.atBlock,
+      hash: reference.context.blockHash,
+      reference: 'PASS', rebuild: 'PASS',
+      proposals: reference.proposals.length,
+      operations: reference.operations.length,
+      treasuryBalance: reference.treasury.balance,
+    },
+    mismatches,
+    reference,
+    rebuild,
+  };
