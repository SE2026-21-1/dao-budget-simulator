+    let stdout = '';
+    let stderr = '';
+    child.stdout.on('data', (data) => { stdout += String(data); });
+    child.stderr.on('data', (data) => { stderr += String(data); });
+    const code = await new Promise<number | null>((resolve, reject) => {
+      child.once('error', reject);
+      child.once('close', resolve);
+    });
