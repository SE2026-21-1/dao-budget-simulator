# Blank VITE_API_BASE_URL selects the canonical fixtures/api dataset.
# Copy to .env.local and fill from a real manifest for BE05 API + wallet mode.
# API_CORS_ORIGINS on the server must include the exact Vite origin.
VITE_API_BASE_URL=
VITE_DEPLOYMENT_ID=
VITE_CHAIN_ID=
VITE_CHAIN_NAME=
VITE_RPC_URL=
VITE_GOVERNOR_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_TIMELOCK_ADDRESS=
VITE_GOV_TOKEN_ADDRESS=
VITE_BUD_TOKEN_ADDRESS=
VITE_EXPLORER_URL=
