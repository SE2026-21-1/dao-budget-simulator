# Documentation only. Copy outside Git and replace every REPLACE_* value.
project_id     = "REPLACE_WITH_DEDICATED_STAGING_PROJECT_UUID"
profile        = "standard"
ubuntu_version = "24.04"
image_id       = "REPLACE_WITH_VERIFIED_UBUNTU_LTS_X86_64_IMAGE_UUID"
image_name     = "ubuntu24.04"
flavor_id      = "REPLACE_WITH_EXISTING_APPROVED_FLAVOR_UUID"
network_id     = "REPLACE_WITH_EXISTING_STAGING_PRIVATE_NETWORK_UUID"
subnet_id      = "REPLACE_WITH_EXISTING_STAGING_IPV4_SUBNET_UUID"
router_id      = "REPLACE_WITH_EXISTING_STAGING_ROUTER_UUID"
keypair_name   = "REPLACE_WITH_EXISTING_KEYPAIR_NAME"
# Documentation-only TEST-NET address, NOT a real administrative source.
admin_cidr = "192.0.2.10/32"

# Null scalar overrides use the profile defaults:
# standard = 4 vCPU / 8192 MiB / 100 GiB; demo = 2 / 4096 / 40.
# For the authorized demo: profile = "demo", optionally root_disk_gb = 30.
vcpus        = null
ram_mb       = null
root_disk_gb = null

# No Cinder service exists in the inspected cloud. Leave this disabled.
boot_from_volume = false
boot_volume_type = null
