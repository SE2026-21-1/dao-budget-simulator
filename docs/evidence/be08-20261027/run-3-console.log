    10   |+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
    11   |+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
    12   |+
    13   |+/// @dev Adversarial test fixture, never used as the production BUD.
    14   |+contract CallbackBudgetToken is ERC20 {
    15   |+    Treasury public target;
    16   |+    bytes public callbackData;
    17   |+    bytes32 public watchedRequest;
    18   |+    bool public returnFalse;
    19   |+    bool public revertTransfer;
    20   |+    bool private entered;
    21   |+    bool public callbackSucceeded;
    22   |+    bool public observedPaid;
    23   |+    bytes public callbackError;
    24   |+    uint256 public callbacks;
    25   |+    uint256 public transfers;
    26   |+
    27   |+    constructor(address holder) ERC20("Mock BUD", "MBUD") {
    28   |+        _mint(holder, 20_000 ether);
    29   |+    }
    30   |+
    31   |+    function configure(Treasury treasury, bytes32 request, bytes memory data, bool fail, bool revertAfterTransfer)
    32   |+        external
    33   |+    {
    34   |+        target = treasury;
    35   |+        watchedRequest = request;
    36   |+        callbackData = data;
    37   |+        returnFalse = fail;
    38   |+        revertTransfer = revertAfterTransfer;
    39   |+    }
    40   |+
    41   |+    function transfer(address to, uint256 amount) public override returns (bool) {
    42   |+        super.transfer(to, amount);
    43   |+        transfers++;
    44   |+        if (msg.sender == address(target) && !entered && callbackData.length != 0) {
    45   |+            entered = true;
    46   |+            observedPaid = target.paidRequests(watchedRequest);
    47   |+            callbacks++;
    48   |+            (callbackSucceeded, callbackError) = address(target).call(callbackData);
    49   |+            entered = false;
    50   |+        }
    51   |+        if (msg.sender == address(target)) {
    52   |+            require(!revertTransfer, "mock failure after transfer");
    53   |+            if (returnFalse) return false;
    54   |+        }
    55   |+        return true;
    56   |+    }
    57   |+}
