+
+export async function loadBe06Manifest(path: string, rpcUrl: string, atBlock: string,
+  deploymentId = '1'): Promise<LoadedManifest> {
+  let bytes: Buffer;
+  let value: unknown;
+  try {
+    bytes = await readFile(path);
+    value = JSON.parse(bytes.toString('utf8'));
