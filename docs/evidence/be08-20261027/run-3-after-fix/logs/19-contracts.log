[stdout]     43   |+    function fund(uint256 amountSeed) external {
[stdout]     44   |+        uint256 available = token.balanceOf(address(this));
[stdout]     45   |+        if (available == 0) return;
[stdout]     46   |+        uint256 amount = bound(amountSeed, 1, available);
[stdout]     47   |+        token.transfer(address(treasury), amount);
[stdout]     48   |+        totalFunded += amount;
[stdout]     49   |+    }
[stdout]     50   |+
[stdout]     51   |+    /// @dev Actor 3 is permanently unprivileged. The other actors can cycle through
[stdout]     52   |+    /// grant, revoke, and self-renounce without resetting request/payment history.
[stdout]     53   |+    function changeRole(uint256 actorSeed, uint256 transitionSeed) external {
[stdout]     54   |+        uint256 index = actorSeed % (ACTOR_COUNT - 1);
[stdout]     55   |+        uint256 transition = transitionSeed % 3;
[stdout]     56   |+        if (transition == 0) {
[stdout]     57   |+            treasury.grantRole(SPENDER, actor(index));
[stdout]     58   |+            expectedSpender[index] = true;
[stdout]     59   |+        } else if (transition == 1) {
[stdout]     60   |+            treasury.revokeRole(SPENDER, actor(index));
[stdout]     61   |+            expectedSpender[index] = false;
