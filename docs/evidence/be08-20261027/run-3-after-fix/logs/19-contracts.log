[stdout]     631  |+/// @dev Shared independent assertions, also used by the multi-step attack trace.
[stdout]     632  |+abstract contract GovernanceOracleChecks is Test {
[stdout]     633  |+    function _assertRequests(GovernanceOracleHandler h) internal view {
[stdout]     634  |+        uint256 payments;
[stdout]     635  |+        for (uint256 i; i < h.REQUEST_COUNT(); ++i) {
[stdout]     636  |+            uint256 count = h.paymentsByRequest(i);
[stdout]     637  |+            assertLe(count, 1, "INV01: repeated committed request payment");
[stdout]     638  |+            assertEq(h.treasury().paidRequests(h.requestId(i)), count == 1, "INV01: paid flag/history mismatch");
[stdout]     639  |+            payments += count;
[stdout]     640  |+        }
[stdout]     641  |+        assertEq(payments, h.successfulExecutions());
[stdout]     642  |+        if (h.sequenceCalls() != 0) assertGe(payments, 1, "non-vacuity: no in-sequence execute");
[stdout]     643  |+    }
[stdout]     644  |+
[stdout]     645  |+    function _assertPathAndRoles(GovernanceOracleHandler h) internal view {
