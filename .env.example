# Set these environment variables before invoking the CLI; no automatic .env loading.
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgresql://be02_demo@127.0.0.1:5432/be02_demo
# Watch mode only; CLI flag --poll-interval-ms takes precedence. Range 100..60000.
INDEXER_POLL_INTERVAL_MS=5000
API_HOST=127.0.0.1
API_PORT=3000
# Replace with a stable randomly generated value of at least 32 bytes.
API_CURSOR_SECRET=replace-this-with-at-least-32-random-bytes-before-running
API_SNAPSHOT_TTL_SECONDS=900
# Optional comma-separated exact browser origins; leave empty when not needed.
API_CORS_ORIGINS=

# BE06 is an explicit offline rebuild/compare target; it never changes DATABASE_URL/API.
# Copy a TV4-verified handoff.json and set an explicit decimal --at H when invoking.
BE06_MANIFEST_PATH=/absolute/path/to/verified-handoff.json
BE06_REFERENCE_DATABASE_URL=postgresql://be06_readonly@127.0.0.1:5432/dao_reference
BE06_TARGET_DATABASE_URL=postgresql://be06_rebuild@127.0.0.1:5432/dao_rebuild_new
