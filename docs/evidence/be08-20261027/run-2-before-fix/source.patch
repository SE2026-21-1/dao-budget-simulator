+.empty-state { padding: 28px 16px; border: 1px dashed #c7d5e5; border-radius: 10px; background: #f9fbfd; color: #607087; text-align: center; line-height: 1.55; }
+.empty-state--error { border-color: #e6b6b6; background: #fff8f8; color: #833b3b; }
+.empty-state--error p { margin: 8px 0 16px; }
+.empty-state__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
+.back-link { display: inline-block; margin-bottom: 20px; color: #174a88; font-size: 14px; font-weight: 650; text-decoration: none; }
+.back-link:hover { text-decoration: underline; }
+.status-pill { display: inline-flex; align-items: center; padding: 5px 10px; border-radius: 999px; background: #e9f1fa; color: #174a88; font-size: 12px; font-weight: 700; white-space: nowrap; }
+
+.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
+.stat-card { min-height: 130px; padding: 21px; }
+.stat-card__label { margin: 0; color: #617188; font-size: 13px; }
+.stat-card__value { margin: 17px 0 0; font-size: 28px; font-weight: 760; letter-spacing: -.04em; }
+.stat-card__hint { margin: 5px 0 0; color: #78879a; font-size: 12px; }
+.overview-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(270px, 1fr); gap: 18px; margin-top: 18px; }
+.step-list { margin: 0; padding-left: 19px; color: #53647a; line-height: 1.8; font-size: 14px; }
+
+.filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(170px, 230px); gap: 14px; }
+.field-label { display: block; margin-bottom: 7px; color: #42536a; font-size: 13px; font-weight: 700; }
+.field-control { width: 100%; min-height: 43px; padding: 9px 12px; border: 1px solid #cbd7e5; border-radius: 8px; background: #fff; color: #17233b; }
+.result-count { margin: 18px 0 12px; color: #64748a; font-size: 13px; }
+.proposal-list { display: grid; gap: 12px; }
+.proposal-row { display: flex; justify-content: space-between; align-items: center; gap: 22px; padding: 18px 20px; border: 1px solid #e0e7f0; border-radius: 12px; background: #fff; }
+.proposal-row__main { min-width: 0; }
+.proposal-row .eyebrow, .proposal-id { overflow-wrap: anywhere; }
+.proposal-row__title { margin: 8px 0 5px; font-size: 17px; font-weight: 720; }
+.proposal-row__meta { margin: 0; color: #65758a; font-size: 13px; overflow-wrap: anywhere; }
+.proposal-row__side { display: flex; align-items: end; flex-direction: column; gap: 8px; flex: none; }
+.proposal-row__amount { font-size: 15px; font-weight: 750; overflow-wrap: anywhere; }
+.pagination { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 22px; font-size: 13px; font-weight: 650; }
+.pagination button { min-height: 42px; padding: 9px 14px; border: 1px solid #cad6e5; border-radius: 8px; background: #fff; color: #174a88; cursor: pointer; }
+.pagination button:disabled { cursor: not-allowed; color: #8998aa; opacity: .6; }
+
+.detail-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(250px, 1fr); gap: 18px; }
+.detail-title { display: flex; justify-content: space-between; align-items: start; gap: 16px; margin-bottom: 20px; }
+.detail-title h2 { margin: 0; font-size: 23px; line-height: 1.3; }
+.detail-amount { margin: 7px 0 22px; color: #174a88; font-size: 28px; font-weight: 760; }
+.detail-fields { display: grid; gap: 16px; margin: 0; }
+.detail-fields dt { color: #65758a; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
+.detail-fields dd { margin: 5px 0 0; overflow-wrap: anywhere; font-size: 14px; }
+.description-text { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.6; }
+.notice { padding: 14px 16px; border-radius: 9px; background: #edf4fb; color: #365879; font-size: 13px; line-height: 1.6; }
+.form-preview { display: grid; gap: 18px; max-width: 720px; }
+.preview-field { display: grid; gap: 8px; }
+.preview-field strong { color: #41536b; font-size: 13px; }
+.preview-box { min-height: 43px; padding: 11px 13px; border: 1px dashed #c8d4e3; border-radius: 8px; background: #f8fafc; color: #8b99aa; font-size: 14px; }
+.preview-box--large { min-height: 98px; }
+
+@media (max-width: 850px) {
+  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .overview-grid, .detail-grid { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 600px) {
+  .site-header__inner, .navigation, .page-container { width: min(100% - 28px, 1160px); }
+  .site-header__inner { min-height: 80px; }
+  .brand__mark { width: 37px; height: 37px; }
+  .brand__name { font-size: 14px; }
+  .brand__caption { font-size: 11px; }
+  .header-status { padding: 7px; border-radius: 50%; }
+  .header-status span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .header-status__dot { width: 9px; height: 9px; }
+  .navigation { gap: 23px; }
+  .page-container { padding-block: 20px 42px; }
+  .demo-banner { margin-bottom: 23px; }
+  .page-heading { align-items: start; flex-direction: column; gap: 15px; }
+  .page-heading h1 { font-size: 28px; }
+  .page-heading .button-primary { width: 100%; }
+  .stats-grid { gap: 10px; }
+  .stat-card { min-height: 116px; padding: 15px; }
+  .stat-card__value { font-size: 24px; }
+  .panel { padding: 18px; }
+  .filters { grid-template-columns: 1fr; }
+  .proposal-row { align-items: start; flex-direction: column; gap: 13px; }
+  .proposal-row__side { width: 100%; align-items: center; flex-direction: row; flex-wrap: wrap; gap: 10px; justify-content: space-between; }
+  .pagination button { padding-inline: 10px; }
+  .detail-title { flex-direction: column; }
+}
+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
