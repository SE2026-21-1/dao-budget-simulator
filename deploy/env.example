# Server-only environment, stored outside releases (default /srv/dao/shared/runtime.env).
# Never commit the populated file. Use permissions 0600. Compose does NOT load this
# automatically: pass --env-file /srv/dao/shared/runtime.env and release.env explicitly.
# Password must be URI-safe (generate e.g. openssl rand -hex 32); user/db simple identifiers.
POSTGRES_USER=dao
POSTGRES_DB=dao
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
API_CURSOR_SECRET=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_BYTES
RPC_URL=https://REPLACE_WITH_PRIVATE_RPC_ENDPOINT
CHAIN_ID=11155111
DEPLOYMENT_ID=REPLACE_WITH_VERIFIED_DEPLOYMENT_NAME
DEPLOY_SHARED_DIR=/srv/dao/shared
FRONTEND_PORT=8080
# Optional: comma-separated browser origins. Same-origin /backend proxy needs none.
API_CORS_ORIGINS=
# These are provided ONLY by the verified release.env, never mutable tags:
# FRONTEND_IMAGE=ghcr.io/se2026-21-1/dao-budget-simulator/frontend@sha256:<64 lowercase hex>
# API_IMAGE=ghcr.io/se2026-21-1/dao-budget-simulator/api@sha256:<64 lowercase hex>
# INDEXER_IMAGE=ghcr.io/se2026-21-1/dao-budget-simulator/indexer@sha256:<64 lowercase hex>
#
# /srv/dao/shared/indexer.json: verified deployment config accepted by indexer/config.ts,
# with toBlock="latest" and matching CHAIN_ID. Its deploymentId is numeric SQL ID,
# while DEPLOYMENT_ID above and frontend VITE_DEPLOYMENT_ID are deployment_name.
# RPC_URL overrides rpcUrl in the worker config.
# /srv/dao/shared/frontend.json: PUBLIC STRINGS ONLY (the browser receives every key).
# Required minimum for read-only live UI:
# {"VITE_API_BASE_URL":"/backend","VITE_CHAIN_ID":"11155111","VITE_DEPLOYMENT_ID":"REPLACE_WITH_VERIFIED_DEPLOYMENT_NAME"}
# Optional wallet-write settings: VITE_RPC_URL (public, credential-free HTTP(S)),
# VITE_GOVERNOR_ADDRESS, VITE_TIMELOCK_ADDRESS, VITE_TREASURY_ADDRESS,
# VITE_GOV_TOKEN_ADDRESS, VITE_BUD_TOKEN_ADDRESS; optional VITE_CHAIN_NAME,
# VITE_EXPLORER_URL. RPC must not contain API keys; use an intentionally public endpoint.
# VITE_DATA_SOURCE may only be "live"; fixture selection is forbidden in containers.
# Missing/invalid public JSON prevents startup. Images have no environment-specific build args.
# API and PostgreSQL have no host ports. Put a TLS reverse proxy in front of loopback 8080.
# Worker probe checks canonical lastCheckedAt freshness (30 seconds), ready phase,
# and equality of raw/published checkpoint heights. Monitor API sync/lag separately.
