# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Foundry generated files
/cache/
/out/
/broadcast/

# Local secrets
.env
.env.*
!.env.example

# Node/TypeScript generated files
/node_modules
/dist/
/coverage/
/indexer/config/local*.json

# Deployment data and cloud credentials never belong in source control.
*.tfstate
*.tfstate.*
*.tfplan
*.dump
*.dump.*
clouds.yaml
secure.yaml
passwords.yml
admin-openrc.sh
/infra/kolla/globals.yml
