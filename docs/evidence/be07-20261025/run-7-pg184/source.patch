diff --git a/indexer/recovery.ts b/indexer/recovery.ts
new file mode 100755
index 0000000..0f72900
--- /dev/null
+++ b/indexer/recovery.ts
@@ -0,0 +1,93 @@
+import type { Pool, PoolClient } from 'pg';
+import { IndexerError } from './errors.js';
+import { readHeader } from './reader.js';
+import { quantity, type RpcTransport } from './rpc.js';
+import { firstBlock } from './scope.js';
+import { checkpoint, verifyMetadata, type TransactionHooks } from './storage.js';
+import type { Checkpoint, IndexerConfig } from './types.js';
+
+export async function runtime(client: PoolClient, deploymentId: string): Promise<Record<string, unknown> | null> {
+  const r = await client.query('SELECT to_jsonb(d)->\'indexer_state\' AS state FROM deployments d WHERE deployment_id=$1', [deploymentId]);
+  return r.rows[0]?.state ?? null;
+}
+export async function lock(client: PoolClient, config: IndexerConfig): Promise<void> {
+  await client.query('SELECT pg_advisory_xact_lock(hashtextextended($1, 0))', [`be02-chain:${config.chainId}`]);
+}
+export function sameCheckpoint(a: Checkpoint | null, b: Checkpoint | null): boolean {
+  return a?.number === b?.number && a?.hash === b?.hash;
+}
+
+/** Commit the serving gate before doing any RPC search or destructive work. */
+export async function recover(pool: Pool, config: IndexerConfig, rpc: RpcTransport, expected: Checkpoint,
+  hooks: TransactionHooks): Promise<Checkpoint | null> {
+  if (quantity(await rpc.call('eth_chainId', []), 'chainId') !== config.chainId)
+    throw new IndexerError('CHAIN_ID_MISMATCH', 'Recovery RPC chain differs from deployment.');
+  const c = await pool.connect();
+  let revision: string;
+  try {
+    await c.query('BEGIN'); await lock(c, config); await verifyMetadata(c, config, true);
+    const current = await checkpoint(c, config);
+    if (!sameCheckpoint(current, expected)) throw new IndexerError('REORG_RETRY', 'Recovery observed a stale checkpoint; restart.');
+    const state = await runtime(c, config.deploymentId);
+    if (!state) throw new IndexerError('CHECKPOINT_HASH_MISMATCH', 'Apply migration 005 for automatic BE07 recovery.');
+    if (state.phase === 'rebuild_required') throw new IndexerError('REBUILD_REQUIRED', 'Rebuild into a new database using BE06.');
+    if (state.phase !== 'recovering') {
+      await c.query(`UPDATE deployments SET snapshot_revision=gen_random_uuid(),
+        indexer_state=indexer_state || jsonb_build_object('phase','recovering','orphanNumber',$2::text,'orphanHash',$3::text)
+        WHERE deployment_id=$1`, [config.deploymentId, expected.number.toString(), expected.hash]);
+      // Invalidate every revision-bound snapshot, including snapshots below the fork.
+      if ((await c.query("SELECT to_regclass('api_read_snapshots') AS t")).rows[0].t)
+        await c.query('UPDATE api_read_snapshots SET invalidated_at=clock_timestamp() WHERE deployment_id=$1 AND invalidated_at IS NULL', [config.deploymentId]);
+    }
+    revision = (await c.query('SELECT snapshot_revision::text AS r FROM deployments WHERE deployment_id=$1', [config.deploymentId])).rows[0].r;
+    await c.query('COMMIT');
+  } catch (e) { await c.query('ROLLBACK'); throw e; } finally { c.release(); }
+  await hooks.recoveryMarked?.();
+
+  // Retain all prefix headers for BE03/BE05. Only the search depth is bounded.
+  const head = quantity(await rpc.call('eth_blockNumber', []), 'head');
+  const ceiling = head < expected.number ? head : expected.number;
+  const floor = expected.number - BigInt(config.reorgWindow ?? 128);
+  const rows = await pool.query(`SELECT block_number::text AS n,block_hash AS hash FROM indexed_blocks
+    WHERE deployment_id=$1 AND block_number BETWEEN $2 AND $3 ORDER BY block_number DESC`,
+  [config.deploymentId, (floor > firstBlock(config) ? floor : firstBlock(config)).toString(), ceiling.toString()]);
+  let ancestor: Checkpoint | null = null;
+  for (const row of rows.rows) {
+    const h = await readHeader(rpc, BigInt(row.n)); // RPC failure preserves the durable gate and ALL data.
+    if (h.hash === row.hash) { ancestor = { number: h.number, hash: h.hash }; break; }
+  }
+  if (ancestor && (await readHeader(rpc, ancestor.number)).hash !== ancestor.hash)
+    throw new IndexerError('REORG_RETRY', 'Canonical ancestor changed during search; gate remains closed.');
+  if (quantity(await rpc.call('eth_chainId', []), 'chainId') !== config.chainId)
+    throw new IndexerError('CHAIN_ID_MISMATCH', 'RPC chain changed during ancestor search; gate remains closed.');
+  const tx = await pool.connect();
+  try {
+    await tx.query('BEGIN'); await lock(tx, config); await verifyMetadata(tx, config, true);
+    const state = await runtime(tx, config.deploymentId);
+    const generation = (await tx.query('SELECT snapshot_revision::text AS r FROM deployments WHERE deployment_id=$1', [config.deploymentId])).rows[0].r;
+    if (generation !== revision || state?.phase !== 'recovering' || !sameCheckpoint(await checkpoint(tx, config), expected))
+      throw new IndexerError('REORG_RETRY', 'Another recovery completed; restart.');
+    if (!ancestor) {
+      await tx.query(`UPDATE deployments SET indexer_state=indexer_state || '{"phase":"rebuild_required"}'::jsonb WHERE deployment_id=$1`, [config.deploymentId]);
+      await tx.query("UPDATE checkpoints SET sync_status='rebuild_required',last_error_code='REORG_WINDOW_EXCEEDED' WHERE deployment_id=$1", [config.deploymentId]);
+    } else {
+      // Remove the latest-only model in dependency order, then the orphan raw suffix.
+      for (const table of ['disbursements','proposal_states','votes','operations','transfers','proposals','projection_checkpoints']) {
+        if ((await tx.query('SELECT to_regclass($1) AS t', [table])).rows[0].t)
+          await tx.query(`DELETE FROM ${table} WHERE deployment_id=$1`, [config.deploymentId]);
+      }
+      await tx.query(`UPDATE checkpoints SET block_number=$2,block_hash=$3,sync_status='syncing',updated_at=clock_timestamp()
+        WHERE deployment_id=$1`, [config.deploymentId, ancestor.number.toString(), ancestor.hash]);
+      await tx.query('DELETE FROM raw_events WHERE deployment_id=$1 AND block_number>$2', [config.deploymentId, ancestor.number.toString()]);
+      await tx.query('DELETE FROM indexed_blocks WHERE deployment_id=$1 AND block_number>$2', [config.deploymentId, ancestor.number.toString()]);
+      await tx.query(`UPDATE deployments SET indexer_state=indexer_state ||
+        jsonb_build_object('phase','replaying','ancestorNumber',$2::text,'ancestorHash',$3::text) WHERE deployment_id=$1`,
+      [config.deploymentId, ancestor.number.toString(), ancestor.hash]);
+    }
+    await hooks.beforeRollbackCommit?.();
+    await tx.query('COMMIT');
+  } catch (e) { await tx.query('ROLLBACK'); throw e; } finally { tx.release(); }
+  await hooks.afterRollbackCommit?.();
+  if (!ancestor) throw new IndexerError('REBUILD_REQUIRED', 'No trusted ancestor within reorgWindow. Use BE06 to rebuild a new database and compare at canonical H/hash.');
+  return ancestor;
+}
diff --git a/indexer/worker.ts b/indexer/worker.ts
new file mode 100755
index 0000000..1f3c3cd
--- /dev/null
+++ b/indexer/worker.ts
@@ -0,0 +1,32 @@
+import type { Pool } from 'pg';
+import { IndexerError, publicError } from './errors.js';
+import { HttpRpc, pause, type RpcTransport } from './rpc.js';
+import { PostgresStorage, StorageError } from './storage.js';
+import { sync, SyncError } from './syncer.js';
+import { project } from './projection/projector.js';
+import type { IndexerConfig } from './types.js';
+
+const transient = new Set(['RPC_UNAVAILABLE','CHECKPOINT_HEAD_BEHIND','REORG_RETRY','BLOCK_CHANGED']);
+/** One serial writer loop; shutdown aborts HTTP, body reads and backoff. */
+export async function worker(config: IndexerConfig, pool: Pool, signal: AbortSignal,
+  emit: (value: unknown) => void, rpc: RpcTransport = new HttpRpc(config.rpcUrl, 5000, { signal })): Promise<void> {
+  if (config.toBlock !== 'latest') throw new IndexerError('INVALID_CONFIG', 'Worker requires toBlock=latest.');
+  const state = (await pool.query("SELECT to_jsonb(d)->'indexer_state' AS state FROM deployments d WHERE deployment_id=$1", [config.deploymentId])).rows[0]?.state;
+  if (!state) throw new IndexerError('INVALID_CONFIG', 'BE07 worker requires migration 005 and existing deployment metadata.');
+  const storage = new PostgresStorage(pool);
+  while (!signal.aborted) {
+    try {
+      await sync(config, rpc, storage);
+      const cp = await storage.loadCheckpoint(config);
+      if (cp) {
+        emit({ type: 'worker_publication', ...(await project(config, rpc, pool)) });
+      }
+    } catch (error) {
+      if (signal.aborted) return;
+      const info = error instanceof SyncError ? error.report.error! : error instanceof StorageError ? {code:error.code,message:error.message,retryable:error.retryable} : publicError(error);
+      emit({ type: 'worker_error', ...info });
+      if (!transient.has(info.code) && !('retryable' in info && info.retryable)) throw error;
+    }
+    try { await pause(config.pollIntervalMs ?? 1000, signal); } catch { if (!signal.aborted) throw new IndexerError('WORKER_FAILED', 'Worker timer failed.'); }
+  }
+}
diff --git a/scripts/check_be07_live.mjs b/scripts/check_be07_live.mjs
new file mode 100755
index 0000000..8bdc588
--- /dev/null
+++ b/scripts/check_be07_live.mjs
@@ -0,0 +1,153 @@
+// Invoked by check_be04_live.mjs after its real eight-proposal governance history.
+import assert from 'node:assert/strict';
+import pg from 'pg';
+import { id, toQuantity } from 'ethers';
+import { parseBe06Manifest } from '../indexer/be06/manifest.ts';
+import { rebuildDatabase } from '../indexer/be06/rebuild.ts';
+import { compareDatabases } from '../indexer/be06/compare.ts';
+import { worker } from '../indexer/worker.ts';
+import { HttpRpc } from '../indexer/rpc.ts';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { once } from 'node:events';
+
+export async function checkBe07Live(x) {
+  const {pool,config,rpc,transport,storage,project,sync,tx,accounts,address,manifest,reorgSnapshot,reorgAncestor,apiGet,baselineRoot,stable,call,abi}=x;
+  const beforeHead=BigInt(await rpc('eth_blockNumber'));
+  const before=(await pool.query('SELECT block_number::text AS h,block_hash AS hash FROM checkpoints WHERE deployment_id=$1',[config.deploymentId])).rows[0];
+  const first=await apiGet('/proposals',new URLSearchParams({chainId:'31337',deploymentId:'be04-live',limit:'1'}));
+  assert.equal(first.status,200);const cursor=first.body.pagination.nextCursor;assert.ok(cursor);
+  const oldModel=await stable();
+  assert.equal(await rpc('evm_revert',[reorgSnapshot]),true);
+  const shallowSnapshot=await rpc('evm_snapshot',[]);
+  // Alternate branch replaces ALL proposal/vote/operation/payment events, at the same head.
+  await tx('BE07 alternate canonical deposit',accounts.funding,'BUD','transfer',[address.Treasury,7n*10n**18n]);
+  let canonicalProposal;
+  if (!baselineRoot) {
+    const description='BE07 canonical proposal replacement';
+    const args=[[address.Treasury],['0'],[abi.Treasury.encodeFunctionData('disburse',[id('be07:new-request'),accounts.recipient,11n*10n**18n])],description];
+    canonicalProposal=String((await call('Governor','hashProposal',[...args.slice(0,3),id(description)]))[0]);
+    await tx('BE07 canonical propose',accounts.A,'Governor','propose',args);
+    const snapshot=BigInt((await call('Governor','proposalSnapshot',[canonicalProposal]))[0]);
+    const deadline=BigInt((await call('Governor','proposalDeadline',[canonicalProposal]))[0]);
+    await tx('BE07 canonical vote',accounts.A,'Governor','castVote',[canonicalProposal,1],snapshot+1n);
+    await tx('BE07 canonical queue',accounts.caller,'Governor','queue',[...args.slice(0,3),id(description)],deadline+1n);
+    const queuedAt=BigInt((await rpc('eth_getBlockByNumber',['latest',false])).timestamp);
+    await tx('BE07 canonical execute',accounts.caller,'Governor','execute',[...args.slice(0,3),id(description)],queuedAt+120n);
+  }
+  const branchHead=BigInt(await rpc('eth_blockNumber'));
+  await rpc('anvil_mine',[toQuantity(beforeHead-branchHead),'0x1']);
+  assert.equal(BigInt(await rpc('eth_blockNumber')),beforeHead);
+  const newHeader=await rpc('eth_getBlockByNumber',[toQuantity(BigInt(before.h)),false]);
+  assert.notEqual(newHeader.hash,before.hash);
+  config.toBlock=BigInt(before.h);
+  const result={before:{...before,head:String(beforeHead)},ancestor:{h:String(BigInt(reorgAncestor.number)),hash:reorgAncestor.hash},
+    canonical:{h:before.h,hash:newHeader.hash,head:String(beforeHead)},mode:baselineRoot?'baseline':'BE07'};
+  if(baselineRoot){
+    let failure;try{await sync(config,transport,storage);}catch(e){failure=e.report;}
+    assert.equal(failure.error.code,'CHECKPOINT_HASH_MISMATCH');
+    const orphanApi=await apiGet('/summary');
+    assert.equal(orphanApi.status,200);assert.equal(orphanApi.body.context.asOfBlockHash,before.hash);
+    assert.equal(orphanApi.body.context.sync.status,'synced');assert.deepEqual(await stable(),oldModel);
+    return {...result,status:'REPRODUCED_OLD_BUG',failure,orphanApi};
+  }
+  await sync(config,transport,storage);
+  const gateHealth=await apiGet('/health'),gateData=await apiGet('/summary');
+  assert.equal(gateHealth.status,503);assert.equal(gateHealth.body.data.recoveryStatus,'replaying');
+  assert.equal(gateData.status,503);
+  const cursorQuery=new URLSearchParams({chainId:'31337',deploymentId:'be04-live',limit:'1',cursor});
+  const duringCursor=await apiGet('/proposals',cursorQuery);assert.equal(duringCursor.status,409);assert.equal(duringCursor.body.error.code,'SNAPSHOT_INVALIDATED');
+  result.publicationCrashes=[];
+  for(const boundary of ['beforePublicationCommit','afterPublicationCommit']){
+    const child=spawn(process.execPath,['--import','tsx','tests/indexer/be07-publication-worker.mjs'],{
+      env:{...process.env,BE07_TEST_DATABASE_URL:pool.options.connectionString,
+        BE07_CRASH_CONFIG:JSON.stringify(config,(_k,v)=>typeof v==='bigint'?String(v):v),BE07_CRASH_BOUNDARY:boundary},
+      stdio:['ignore','pipe','pipe','ipc']});
+    let stderr='';child.stderr.on('data',c=>stderr+=c);const exited=once(child,'exit');let timer;
+    try{
+      const message=await Promise.race([once(child,'message'),exited.then(()=>{throw new Error(stderr||'publication child exited before boundary');}),
+        new Promise((_r,reject)=>{timer=setTimeout(()=>reject(new Error('publication boundary timeout')),15000);})]);
+      assert.equal(message[0].boundary,boundary);
+      const visible=(await pool.query("SELECT indexer_state->>'phase' AS phase FROM deployments WHERE deployment_id=$1",[config.deploymentId])).rows[0].phase;
+      const published=(await pool.query('SELECT block_hash FROM projection_checkpoints WHERE deployment_id=$1',[config.deploymentId])).rows;
+      assert.equal(visible,boundary==='beforePublicationCommit'?'replaying':'ready');
+      assert.equal(published.length,boundary==='beforePublicationCommit'?0:1);
+      child.kill('SIGKILL');await exited;
+      assert.equal((await apiGet('/summary')).status,boundary==='beforePublicationCommit'?503:200);
+      result.publicationCrashes.push({boundary,signal:'SIGKILL',visiblePhase:visible,publication:published});
+    }finally{
+      clearTimeout(timer);if(child.exitCode===null&&child.signalCode===null){child.kill('SIGKILL');await exited;}
