[stdout]     647  |+        assertEq(h.unauthorizedSuccesses(), 0, "INV02: direct authority bypass");
[stdout]     648  |+        Treasury t = h.treasury();
[stdout]     649  |+        TimelockController l = h.timelock();
[stdout]     650  |+        BudgetGovernor g = h.governor();
[stdout]     651  |+        // The universe includes every address to which these fixtures can grant
[stdout]     652  |+        // authority, plus zero; AccessControl is not enumerable.
[stdout]     653  |+        address[14] memory accounts = [
[stdout]     654  |+            address(0),
[stdout]     655  |+            h.bootstrap(),
[stdout]     656  |+            h.funding(),
[stdout]     657  |+            address(h),
[stdout]     658  |+            address(t),
[stdout]     659  |+            address(l),
[stdout]     660  |+            address(g),
[stdout]     661  |+            address(h.gov()),
[stdout]     662  |+            address(h.bud()),
[stdout]     663  |+            h.actor(0),
[stdout]     664  |+            h.actor(1),
[stdout]     665  |+            h.actor(2),
[stdout]     666  |+            h.actor(3),
[stdout]     667  |+            h.actor(4)
[stdout]     668  |+        ];
[stdout]     669  |+        for (uint256 i; i < accounts.length; ++i) {
[stdout]     670  |+            _assertRoleHolder(t, l, g, accounts[i]);
[stdout]     671  |+        }
[stdout]     672  |+        for (uint256 i; i < h.RECIPIENT_COUNT(); ++i) {
[stdout]     673  |+            _assertRoleHolder(t, l, g, h.recipient(i));
[stdout]     674  |+        }
[stdout]     675  |+        assertEq(address(g.token()), address(h.gov()));
[stdout]     676  |+        assertEq(address(g.treasury()), address(t));
[stdout]     677  |+        assertEq(g.timelock(), address(l));
[stdout]     678  |+        assertEq(address(t.budgetToken()), address(h.bud()));
[stdout]     679  |+        assertEq(l.getMinDelay(), 120);
[stdout]     680  |+        assertEq(g.votingDelay(), 60);
[stdout]     681  |+        assertEq(g.votingPeriod(), 300);
[stdout]     682  |+        assertEq(g.proposalThreshold(), 50 ether);
[stdout]     683  |+        assertEq(g.quorumNumerator(), 20);
[stdout]     684  |+        for (uint256 i; i < h.proposalCount(); ++i) {
[stdout]     685  |+            GovernanceOracleHandler.Proposal memory p = h.proposal(i);
[stdout]     686  |+            assertEq(uint256(g.state(p.id)), uint256(h.expectedState(i)), "INV02: proposal state/history mismatch");
[stdout]     687  |+            assertEq(g.proposalProposer(p.id), h.actor(p.proposerIndex));
[stdout]     688  |+            assertEq(g.proposalSnapshot(p.id), p.snapshot);
[stdout]     689  |+            assertEq(g.proposalDeadline(p.id), p.deadline);
[stdout]     690  |+            assertEq(g.proposalEta(p.id), p.eta);
[stdout]     691  |+            if (p.eta != 0) {
[stdout]     692  |+                assertGt(p.queuedAt, p.deadline, "INV02: queue before deadline");
[stdout]     693  |+                assertGe(p.tallies[1] + p.tallies[2], h.QUORUM());
