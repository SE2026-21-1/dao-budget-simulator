    93   |+        assertEq(fresh.getRoleAdmin(SPENDER), ADMIN);
    94   |+        assertEq(fresh.getRoleAdmin(ADMIN), ADMIN);
    95   |+        assertTrue(fresh.hasRole(ADMIN, admin));
    96   |+        assertFalse(fresh.hasRole(SPENDER, admin));
    97   |+        assertFalse(fresh.hasRole(ADMIN, address(this)));
    98   |+        assertFalse(fresh.hasRole(SPENDER, address(0)));
    99   |+        assertFalse(fresh.paidRequests(REQUEST));
    100  |+    }
