+    lastIndexedAt: raw?.updatedAt ?? null, lastRpcCheckAt: recovery?.lastCheckedAt ?? null,
+    recoveryStatus: raw?.status === 'rebuild_required' ? 'rebuild_required' : recovery?.phase ?? 'unverified' };
