-```bash
-node --import tsx scripts/smoke_governance.mjs --output /tmp/sc04-local-smoke.json
-FOUNDRY_PROFILE=ci FOUNDRY_FUZZ_SEED=0x20261021 forge test --match-path tests/invariant/GovernanceInvariant.t.sol -vv
