[stdout]     13   |+/// @dev Adversarial test fixture, never used as the production BUD.
[stdout]     14   |+contract CallbackBudgetToken is ERC20 {
[stdout]     15   |+    Treasury public target;
[stdout]     16   |+    bytes public callbackData;
[stdout]     17   |+    bytes32 public watchedRequest;
[stdout]     18   |+    bool public returnFalse;
[stdout]     19   |+    bool public revertTransfer;
[stdout]     20   |+    bool private entered;
[stdout]     21   |+    bool public callbackSucceeded;
[stdout]     22   |+    bool public observedPaid;
[stdout]     23   |+    bytes public callbackError;
[stdout]     24   |+    uint256 public callbacks;
[stdout]     25   |+    uint256 public transfers;
[stdout]     26   |+
[stdout]     27   |+    constructor(address holder) ERC20("Mock BUD", "MBUD") {
[stdout]     28   |+        _mint(holder, 20_000 ether);
[stdout]     29   |+    }
[stdout]     30   |+
[stdout]     31   |+    function configure(Treasury treasury, bytes32 request, bytes memory data, bool fail, bool revertAfterTransfer)
[stdout]     32   |+        external
[stdout]     33   |+    {
[stdout]     34   |+        target = treasury;
[stdout]     35   |+        watchedRequest = request;
[stdout]     36   |+        callbackData = data;
[stdout]     37   |+        returnFalse = fail;
[stdout]     38   |+        revertTransfer = revertAfterTransfer;
[stdout]     39   |+    }
[stdout]     40   |+
[stdout]     41   |+    function transfer(address to, uint256 amount) public override returns (bool) {
[stdout]     42   |+        super.transfer(to, amount);
[stdout]     43   |+        transfers++;
[stdout]     44   |+        if (msg.sender == address(target) && !entered && callbackData.length != 0) {
[stdout]     45   |+            entered = true;
[stdout]     46   |+            observedPaid = target.paidRequests(watchedRequest);
[stdout]     47   |+            callbacks++;
[stdout]     48   |+            (callbackSucceeded, callbackError) = address(target).call(callbackData);
[stdout]     49   |+            entered = false;
[stdout]     50   |+        }
[stdout]     51   |+        if (msg.sender == address(target)) {
[stdout]     52   |+            require(!revertTransfer, "mock failure after transfer");
[stdout]     53   |+            if (returnFalse) return false;
[stdout]     54   |+        }
[stdout]     55   |+        return true;
[stdout]     56   |+    }
[stdout]     57   |+}
