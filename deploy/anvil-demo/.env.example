# Copy to an ignored .env locally. These are Compose inputs, not application secrets.
DAO_DEMO_HOME=/home/ubuntu/dao-demo
DAO_UID=1000
DAO_GID=1000
# Existing images built from the source revision actually deployed:
API_IMAGE=dao-api:896f93e
INDEXER_IMAGE=dao-indexer:896f93e
# Fill using docker image inspect after pulling the official cloudflared image.
TUNNEL_IMAGE=REPLACE_WITH_CLOUDFLARED_REPODIGEST
