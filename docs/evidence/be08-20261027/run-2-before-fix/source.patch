+  },
+  confirmationPolicy: { depth: '2' },
+});
+
+test('BE06 parses the verified TV4 handoff without requiring a source deployment id', () => {
+  const parsed = parseBe06Manifest(manifest(), 'http://127.0.0.1:8545', '80');
