    1    |+// SPDX-License-Identifier: MIT
    2    |+pragma solidity ^0.8.24;
    3    |+
    4    |+import {Test} from "forge-std/Test.sol";
    5    |+import {Vm} from "forge-std/Vm.sol";
    6    |+import {BudgetGovernor} from "../../contracts/BudgetGovernor.sol";
    7    |+import {GovernanceToken} from "../../contracts/GovernanceToken.sol";
    8    |+import {BudgetToken} from "../../contracts/BudgetToken.sol";
    9    |+import {Treasury} from "../../contracts/Treasury.sol";
    10   |+import {ITreasury} from "../../contracts/interfaces/ITreasury.sol";
    11   |+import {IGovernor} from "@openzeppelin/contracts/governance/IGovernor.sol";
    12   |+import {TimelockController} from "@openzeppelin/contracts/governance/TimelockController.sol";
    13   |+
    14   |+/// @dev Bounded local model: five EOA voters, four passive BUD recipients, 16
    15   |+/// requests and at most 24 proposals. No minting, storage writes, privileged
    16   |+/// impersonation, external tokens, signatures, reorgs, indexer or UI assumptions.
    17   |+/// Token balances/delegates and timestamp checkpoints are ghost state, NOT read
    18   |+/// from GOV. Payment predictions never consult Treasury.paidRequests/balance.
    19   |+contract GovernanceOracleHandler is Test {
    20   |+    uint256 public constant ACTOR_COUNT = 5;
    21   |+    uint256 public constant RECIPIENT_COUNT = 4;
    22   |+    uint256 public constant REQUEST_COUNT = 16;
    23   |+    uint256 public constant MAX_PROPOSALS = 24;
    24   |+    uint256 public constant SUPPLY = 1_000 ether;
    25   |+    uint256 public constant QUORUM = 200 ether;
    26   |+
    27   |+    enum CallKind {
    28   |+        Propose,
    29   |+        Vote,
    30   |+        Queue,
    31   |+        Execute,
    32   |+        Cancel,
    33   |+        Fund,
    34   |+        Transfer,
    35   |+        Delegate,
    36   |+        Unauthorized,
    37   |+        Tamper,
    38   |+        Approve,
    39   |+        TransferFrom
    40   |+    }
    41   |+
    42   |+    struct Proposal {
    43   |+        uint256 id;
    44   |+        uint256 request;
    45   |+        uint256 recipientIndex;
    46   |+        uint256 amount;
    47   |+        uint256 proposerIndex;
    48   |+        uint256 snapshot;
    49   |+        uint256 deadline;
    50   |+        uint256 eta;
    51   |+        uint256 queuedAt;
    52   |+        uint256 executedAt;
    53   |+        bytes32 descriptionHash;
    54   |+        bytes32 operation;
    55   |+        uint256[5] weights;
    56   |+        uint256[3] tallies;
    57   |+        uint256 votedMask;
    58   |+        bool pinned;
    59   |+        bool canceled;
    60   |+        bool executed;
    61   |+        bool validExecution;
    62   |+    }
    63   |+
    64   |+    struct Checkpoint {
    65   |+        uint256 timestamp;
    66   |+        uint256[5] weights;
    67   |+    }
    68   |+
    69   |+    GovernanceToken public immutable gov;
    70   |+    BudgetToken public immutable bud;
    71   |+    Treasury public immutable treasury;
    72   |+    TimelockController public immutable timelock;
    73   |+    BudgetGovernor public immutable governor;
    74   |+    Proposal[] internal proposals;
    75   |+    Checkpoint[] internal checkpoints;
    76   |+    uint256[5] public balances;
    77   |+    uint256[5] public delegates; // ACTOR_COUNT denotes undelegated/address(0).
    78   |+    uint256[5][5] public allowances;
    79   |+    uint256[8] public stateVisits;
    80   |+    uint256[16] public paymentsByRequest;
    81   |+    uint256[4] public received;
    82   |+    uint256[12] public attempts;
    83   |+    uint256[12] public successes;
    84   |+    uint256[12] public reverts;
    85   |+    uint256 public totalFunded;
    86   |+    uint256 public totalPaid;
    87   |+    uint256 public successfulExecutions;
    88   |+    uint256 public spontaneousExecutions;
    89   |+    uint256 public reachableExecutions;
    90   |+    uint256 public reachableCalls;
    91   |+    uint256 public sequenceCalls;
    92   |+    uint256 public unauthorizedSuccesses;
    93   |+    bool public unexpectedOutcome;
    94   |+
    95   |+    constructor() {
    96   |+        // Bootstrap is a real EOA, distinct from the handler and every voter.
    97   |+        vm.startPrank(bootstrap());
    98   |+        gov = new GovernanceToken(actor(0), actor(1), actor(2), actor(3));
    99   |+        bud = new BudgetToken(funding());
    100  |+        treasury = new Treasury(address(bud), bootstrap());
    101  |+        timelock = new TimelockController(120, new address[](0), new address[](0), bootstrap());
    102  |+        governor = new BudgetGovernor(address(gov), address(treasury), address(timelock));
    103  |+        treasury.grantRole(treasury.DEFAULT_ADMIN_ROLE(), address(timelock));
    104  |+        treasury.grantRole(treasury.SPENDER_ROLE(), address(timelock));
    105  |+        timelock.grantRole(timelock.PROPOSER_ROLE(), address(governor));
    106  |+        timelock.grantRole(timelock.EXECUTOR_ROLE(), address(governor));
    107  |+        timelock.grantRole(timelock.CANCELLER_ROLE(), address(governor));
    108  |+        treasury.renounceRole(treasury.DEFAULT_ADMIN_ROLE(), bootstrap());
    109  |+        timelock.renounceRole(timelock.DEFAULT_ADMIN_ROLE(), bootstrap());
    110  |+        vm.stopPrank();
    111  |+
    112  |+        // Authority is already final BEFORE the first BUD funding transaction.
    113  |+        _fund(10_000 ether);
    114  |+        balances[0] = 400 ether;
    115  |+        balances[1] = 300 ether;
    116  |+        balances[2] = 200 ether;
    117  |+        balances[3] = 100 ether;
    118  |+        for (uint256 i; i < ACTOR_COUNT; ++i) {
    119  |+            delegates[i] = i;
    120  |+            vm.prank(actor(i));
    121  |+            gov.delegate(actor(i));
    122  |+        }
    123  |+        _checkpoint();
    124  |+        _advance(block.timestamp + 1);
    125  |+    }
    126  |+
    127  |+    function actor(uint256 i) public pure returns (address) {
    128  |+        return address(uint160(0xA400 + i % ACTOR_COUNT));
    129  |+    }
    130  |+
    131  |+    function recipient(uint256 i) public pure returns (address) {
    132  |+        return address(uint160(0xB400 + i % RECIPIENT_COUNT));
    133  |+    }
    134  |+
    135  |+    function bootstrap() public pure returns (address) {
    136  |+        return address(0xC401);
    137  |+    }
    138  |+
    139  |+    function funding() public pure returns (address) {
    140  |+        return address(0xC402);
    141  |+    }
    142  |+
    143  |+    function proposalCount() public view returns (uint256) {
    144  |+        return proposals.length;
    145  |+    }
    146  |+
    147  |+    function proposal(uint256 i) public view returns (Proposal memory) {
    148  |+        return proposals[i];
    149  |+    }
    150  |+
    151  |+    function requestId(uint256 i) public pure returns (bytes32) {
    152  |+        return bytes32(i % REQUEST_COUNT);
    153  |+    }
    154  |+
    155  |+    function currentWeights() public view returns (uint256[5] memory weights) {
    156  |+        for (uint256 i; i < ACTOR_COUNT; ++i) {
    157  |+            if (delegates[i] < ACTOR_COUNT) weights[delegates[i]] += balances[i];
    158  |+        }
    159  |+    }
    160  |+
    161  |+    function expectedState(uint256 i) public view returns (IGovernor.ProposalState) {
    162  |+        Proposal storage p = proposals[i];
    163  |+        if (p.executed) return IGovernor.ProposalState.Executed;
    164  |+        if (p.canceled) return IGovernor.ProposalState.Canceled;
    165  |+        if (block.timestamp <= p.snapshot) return IGovernor.ProposalState.Pending;
    166  |+        if (block.timestamp <= p.deadline) return IGovernor.ProposalState.Active;
    167  |+        if (p.tallies[1] + p.tallies[2] < QUORUM || p.tallies[1] <= p.tallies[0]) {
    168  |+            return IGovernor.ProposalState.Defeated;
    169  |+        }
    170  |+        return p.eta == 0 ? IGovernor.ProposalState.Succeeded : IGovernor.ProposalState.Queued;
    171  |+    }
    172  |+
    173  |+    // Every selectable action starts the sequence with an actual full lifecycle.
    174  |+    // This is NOT a payment seeded in setUp: it runs inside the fuzz sequence and
    175  |+    // its counters/state disappear on reset. Other calls interleave freely.
    176  |+    function _begin() internal {
    177  |+        sequenceCalls++;
    178  |+        if (sequenceCalls == 1) _reachable(0);
    179  |+        // Sample model states before each action; invariants independently
    180  |+        // compare these states with Governor. Counters are per sequence.
    181  |+        for (uint256 i; i < proposals.length; ++i) {
    182  |+            stateVisits[uint256(expectedState(i))]++;
    183  |+        }
    184  |+    }
    185  |+
    186  |+    function lifecycle(uint256 seed) external {
    187  |+        _begin();
    188  |+        _reachable(seed);
    189  |+    }
    190  |+
    191  |+    function propose(uint256 proposerSeed, uint256 requestSeed, uint256 recipientSeed, uint256 amountSeed) external {
    192  |+        _begin();
    193  |+        _propose(
    194  |+            proposerSeed % ACTOR_COUNT,
    195  |+            requestSeed % REQUEST_COUNT,
    196  |+            recipientSeed % RECIPIENT_COUNT,
    197  |+            bound(amountSeed, 1, 15_000 ether)
    198  |+        );
    199  |+    }
    200  |+
    201  |+    function vote(uint256 proposalSeed, uint256 voterSeed, uint256 supportSeed) external {
    202  |+        _begin();
    203  |+        if (proposals.length == 0) return; // Preserve a sticky failed initial lifecycle.
    204  |+        _vote(proposalSeed % proposals.length, voterSeed % ACTOR_COUNT, uint8(supportSeed % 4));
    205  |+    }
    206  |+
    207  |+    function advance(uint256 secondsSeed) external {
    208  |+        _begin();
    209  |+        _advance(block.timestamp + bound(secondsSeed, 0, 600));
    210  |+    }
    211  |+
    212  |+    function queue(uint256 proposalSeed) external {
    213  |+        _begin();
    214  |+        if (proposals.length != 0) _queue(proposalSeed % proposals.length);
    215  |+    }
    216  |+
    217  |+    function execute(uint256 proposalSeed) external {
    218  |+        _begin();
    219  |+        if (proposals.length != 0) _execute(proposalSeed % proposals.length, false);
    220  |+    }
    221  |+
    222  |+    function cancel(uint256 proposalSeed, uint256 callerSeed) external {
    223  |+        _begin();
    224  |+        if (proposals.length == 0) return;
    225  |+        uint256 i = proposalSeed % proposals.length;
    226  |+        uint256 callerIndex = callerSeed % ACTOR_COUNT;
    227  |+        Proposal storage p = proposals[i];
    228  |+        bool expected = expectedState(i) == IGovernor.ProposalState.Pending && callerIndex == p.proposerIndex;
    229  |+        (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    230  |+        (bool ok, bytes memory result) = _call(
    231  |+            CallKind.Cancel,
    232  |+            actor(callerIndex),
    233  |+            address(governor),
    234  |+            abi.encodeCall(governor.cancel, (targets, values, data, p.descriptionHash)),
    235  |+            expected
    236  |+        );
    237  |+        if (ok) {
    238  |+            p.canceled = true;
    239  |+            _checkReturn(result, p.id);
    240  |+        }
    241  |+    }
    242  |+
    243  |+    function fund(uint256 amountSeed) external {
    244  |+        _begin();
    245  |+        _fund(bound(amountSeed, 0, 20_000 ether - totalFunded));
    246  |+    }
    247  |+
    248  |+    function transferGov(uint256 fromSeed, uint256 toSeed, uint256 amountSeed) external {
    249  |+        _begin();
    250  |+        uint256 from = fromSeed % ACTOR_COUNT;
    251  |+        uint256 to = toSeed % ACTOR_COUNT;
    252  |+        uint256 amount = bound(amountSeed, 0, balances[from]);
    253  |+        (bool ok, bytes memory result) =
    254  |+            _call(CallKind.Transfer, actor(from), address(gov), abi.encodeCall(gov.transfer, (actor(to), amount)), true);
    255  |+        if (ok) {
    256  |+            _checkReturn(result, 1);
    257  |+            balances[from] -= amount;
    258  |+            balances[to] += amount;
    259  |+            _checkpoint();
    260  |+        }
    261  |+    }
    262  |+
    263  |+    function approveGov(uint256 ownerSeed, uint256 spenderSeed, uint256 amountSeed) external {
    264  |+        _begin();
    265  |+        uint256 owner = ownerSeed % ACTOR_COUNT;
    266  |+        uint256 spender = spenderSeed % ACTOR_COUNT;
    267  |+        uint256 amount = amountSeed == type(uint256).max ? amountSeed : bound(amountSeed, 0, 2_000 ether);
    268  |+        (bool ok, bytes memory result) = _call(
    269  |+            CallKind.Approve, actor(owner), address(gov), abi.encodeCall(gov.approve, (actor(spender), amount)), true
    270  |+        );
    271  |+        if (ok) {
    272  |+            _checkReturn(result, 1);
    273  |+            allowances[owner][spender] = amount;
    274  |+        }
    275  |+    }
    276  |+
    277  |+    function transferFromGov(uint256 owner, uint256 spender, uint256 to, uint256 amountSeed) external {
    278  |+        _begin();
    279  |+        owner %= ACTOR_COUNT;
    280  |+        spender %= ACTOR_COUNT;
    281  |+        to %= ACTOR_COUNT;
    282  |+        uint256 amount = bound(amountSeed, 0, 2_000 ether);
    283  |+        bool expected = amount <= balances[owner] && amount <= allowances[owner][spender];
    284  |+        bytes memory payload = abi.encodeCall(gov.transferFrom, (actor(owner), actor(to), amount));
    285  |+        (bool ok, bytes memory result) = _call(CallKind.TransferFrom, actor(spender), address(gov), payload, expected);
    286  |+        // Preserve the sticky mismatch on unexpected success without letting an
    287  |+        // underflow in ghost accounting revert/discard the offending action.
    288  |+        if (ok && expected) {
    289  |+            _checkReturn(result, 1);
    290  |+            balances[owner] -= amount;
    291  |+            balances[to] += amount;
    292  |+            if (allowances[owner][spender] != type(uint256).max) allowances[owner][spender] -= amount;
    293  |+            _checkpoint();
    294  |+        }
    295  |+    }
    296  |+
    297  |+    function delegateGov(uint256 fromSeed, uint256 toSeed) external {
    298  |+        _begin();
    299  |+        _delegate(fromSeed % ACTOR_COUNT, toSeed % (ACTOR_COUNT + 1));
    300  |+    }
    301  |+
    302  |+    /// @dev Former bootstrap as well as voters attack the FINAL role graph.
    303  |+    /// Direct execute/cancel uses a genuine existing operation, not an invented ID.
    304  |+    function unauthorized(uint256 kindSeed, uint256 callerSeed, uint256 proposalSeed) external {
    305  |+        _begin();
    306  |+        if (proposals.length == 0) return;
    307  |+        Proposal storage p = proposals[proposalSeed % proposals.length];
    308  |+        address caller = callerSeed % 2 == 0 ? bootstrap() : actor(callerSeed % ACTOR_COUNT);
    309  |+        (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    310  |+        bytes32 salt = bytes32(bytes20(address(governor))) ^ p.descriptionHash;
    311  |+        uint256 kind = kindSeed % 10;
    312  |+        address target = address(timelock);
    313  |+        bytes memory payload;
    314  |+        if (kind == 0) {
    315  |+            target = address(treasury);
    316  |+            payload = data[0];
    317  |+        }
    318  |+        if (kind == 1) {
    319  |+            payload = abi.encodeCall(timelock.scheduleBatch, (targets, values, data, bytes32(0), salt, 120));
    320  |+        }
    321  |+        if (kind == 2) payload = abi.encodeCall(timelock.executeBatch, (targets, values, data, bytes32(0), salt));
    322  |+        if (kind == 3) payload = abi.encodeCall(timelock.cancel, (p.operation));
    323  |+        if (kind == 4) payload = abi.encodeCall(timelock.grantRole, (timelock.PROPOSER_ROLE(), caller));
    324  |+        if (kind == 5) payload = abi.encodeCall(timelock.grantRole, (timelock.EXECUTOR_ROLE(), address(0)));
    325  |+        if (kind == 6) payload = abi.encodeCall(timelock.updateDelay, (uint256(0)));
    326  |+        if (kind == 7) {
    327  |+            target = address(treasury);
    328  |+            payload = abi.encodeCall(treasury.grantRole, (treasury.SPENDER_ROLE(), caller));
    329  |+        }
    330  |+        if (kind == 8) {
    331  |+            target = address(treasury);
    332  |+            payload = abi.encodeCall(treasury.grantRole, (treasury.DEFAULT_ADMIN_ROLE(), caller));
    333  |+        }
    334  |+        if (kind == 9) {
    335  |+            target = address(governor);
    336  |+            payload = abi.encodeCall(governor.setVotingPeriod, (uint32(1)));
    337  |+        }
    338  |+        (bool ok,) = _call(CallKind.Unauthorized, caller, target, payload, false);
    339  |+        if (ok) unauthorizedSuccesses++;
    340  |+    }
    341  |+
    342  |+    function tamper(uint256 proposalSeed, uint256 kindSeed) external {
    343  |+        _begin();
    344  |+        if (proposals.length == 0) return;
    345  |+        Proposal storage p = proposals[proposalSeed % proposals.length];
    346  |+        (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    347  |+        // A new description hash is never used by the bounded proposal universe.
    348  |+        bytes32 alteredHash = keccak256(abi.encode("not-created", p.descriptionHash));
    349  |+        bytes memory payload = kindSeed % 2 == 0
    350  |+            ? abi.encodeCall(governor.queue, (targets, values, data, alteredHash))
    351  |+            : abi.encodeCall(governor.execute, (targets, values, data, alteredHash));
    352  |+        _call(CallKind.Tamper, actor(4), address(governor), payload, false);
    353  |+    }
    354  |+
    355  |+    function _call(CallKind kind, address caller, address target, bytes memory payload, bool expected)
    356  |+        internal
    357  |+        returns (bool ok, bytes memory result)
    358  |+    {
    359  |+        attempts[uint256(kind)]++;
    360  |+        vm.prank(caller);
    361  |+        (ok, result) = target.call(payload);
    362  |+        if (ok) successes[uint256(kind)]++;
    363  |+        else reverts[uint256(kind)]++;
    364  |+        // No assert/expectRevert inside a handler action: a discarded handler
    365  |+        // revert cannot hide the sticky mismatch under fail_on_revert=false.
    366  |+        if (ok != expected) unexpectedOutcome = true;
    367  |+    }
    368  |+
    369  |+    function _checkReturn(bytes memory result, uint256 expected) internal {
    370  |+        if (result.length != 32) {
    371  |+            unexpectedOutcome = true;
    372  |+            return;
    373  |+        }
    374  |+        if (abi.decode(result, (uint256)) != expected) unexpectedOutcome = true;
    375  |+    }
    376  |+
    377  |+    function _checkpoint() internal {
    378  |+        uint256[5] memory weights = currentWeights();
    379  |+        if (checkpoints.length != 0 && checkpoints[checkpoints.length - 1].timestamp == block.timestamp) {
    380  |+            checkpoints[checkpoints.length - 1].weights = weights;
    381  |+        } else {
    382  |+            checkpoints.push(Checkpoint({timestamp: block.timestamp, weights: weights}));
    383  |+        }
    384  |+    }
    385  |+
    386  |+    function _weightsAt(uint256 timestamp) internal view returns (uint256[5] memory weights) {
    387  |+        for (uint256 i = checkpoints.length; i != 0; --i) {
    388  |+            if (checkpoints[i - 1].timestamp <= timestamp) return checkpoints[i - 1].weights;
    389  |+        }
    390  |+    }
    391  |+
    392  |+    function _advance(uint256 timestamp) internal {
    393  |+        if (timestamp > block.timestamp) vm.warp(timestamp);
    394  |+        for (uint256 i; i < proposals.length; ++i) {
    395  |+            Proposal storage p = proposals[i];
    396  |+            if (!p.pinned && p.snapshot < block.timestamp) {
    397  |+                p.weights = _weightsAt(p.snapshot);
    398  |+                p.pinned = true;
    399  |+            }
    400  |+        }
    401  |+    }
    402  |+
    403  |+    function _delegate(uint256 from, uint256 to) internal {
    404  |+        address delegatee = to == ACTOR_COUNT ? address(0) : actor(to);
    405  |+        (bool ok,) =
    406  |+            _call(CallKind.Delegate, actor(from), address(gov), abi.encodeCall(gov.delegate, (delegatee)), true);
    407  |+        if (ok) {
    408  |+            delegates[from] = to;
    409  |+            _checkpoint();
    410  |+        }
    411  |+    }
    412  |+
    413  |+    function _fund(uint256 amount) internal {
    414  |+        (bool ok, bytes memory result) = _call(
    415  |+            CallKind.Fund, funding(), address(bud), abi.encodeCall(bud.transfer, (address(treasury), amount)), true
    416  |+        );
    417  |+        if (ok) {
    418  |+            _checkReturn(result, 1);
    419  |+            totalFunded += amount;
    420  |+        }
    421  |+    }
    422  |+
    423  |+    function _action(Proposal storage p)
    424  |+        internal
    425  |+        view
    426  |+        returns (address[] memory targets, uint256[] memory values, bytes[] memory data)
    427  |+    {
    428  |+        targets = new address[](1);
    429  |+        targets[0] = address(treasury);
    430  |+        values = new uint256[](1);
    431  |+        data = new bytes[](1);
    432  |+        data[0] = abi.encodeCall(ITreasury.disburse, (requestId(p.request), recipient(p.recipientIndex), p.amount));
    433  |+    }
    434  |+
    435  |+    function _propose(uint256 proposerIndex, uint256 request, uint256 recipientIndex, uint256 amount)
    436  |+        internal
    437  |+        returns (bool created, uint256 index)
    438  |+    {
    439  |+        if (proposals.length >= MAX_PROPOSALS) return (false, 0);
    440  |+        index = proposals.length;
    441  |+        proposals.push();
    442  |+        Proposal storage p = proposals[index];
    443  |+        p.request = request;
    444  |+        p.recipientIndex = recipientIndex;
    445  |+        p.amount = amount;
    446  |+        p.proposerIndex = proposerIndex;
    447  |+        p.snapshot = block.timestamp + 60;
    448  |+        p.deadline = block.timestamp + 360;
    449  |+        bytes memory payload;
    450  |+        {
    451  |+            string memory description = string.concat("tv4-stateful-proposal-", vm.toString(index));
    452  |+            p.descriptionHash = keccak256(bytes(description));
    453  |+            (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    454  |+            p.id = uint256(keccak256(abi.encode(targets, values, data, p.descriptionHash)));
    455  |+            p.operation = keccak256(
    456  |+                abi.encode(targets, values, data, bytes32(0), bytes32(bytes20(address(governor))) ^ p.descriptionHash)
    457  |+            );
    458  |+            payload = abi.encodeCall(governor.propose, (targets, values, data, description));
    459  |+        }
    460  |+        bytes memory result;
    461  |+        (created, result) = _call(
    462  |+            CallKind.Propose,
    463  |+            actor(p.proposerIndex),
    464  |+            address(governor),
    465  |+            payload,
    466  |+            _weightsAt(block.timestamp - 1)[p.proposerIndex] >= 50 ether
    467  |+        );
    468  |+        if (!created) {
    469  |+            proposals.pop();
    470  |+            return (false, index);
    471  |+        }
    472  |+        _checkReturn(result, p.id);
    473  |+    }
    474  |+
    475  |+    function _vote(uint256 index, uint256 voter, uint8 support) internal {
    476  |+        Proposal storage p = proposals[index];
    477  |+        bool expected =
    478  |+            expectedState(index) == IGovernor.ProposalState.Active && (p.votedMask & (1 << voter)) == 0 && support < 3;
    479  |+        (bool ok, bytes memory result) = _call(
    480  |+            CallKind.Vote, actor(voter), address(governor), abi.encodeCall(governor.castVote, (p.id, support)), expected
    481  |+        );
    482  |+        if (ok) {
    483  |+            _checkReturn(result, p.weights[voter]);
    484  |+            p.votedMask |= 1 << voter;
    485  |+            if (support < 3) p.tallies[support] += p.weights[voter];
    486  |+        }
    487  |+    }
    488  |+
    489  |+    function _queue(uint256 index) internal {
    490  |+        Proposal storage p = proposals[index];
    491  |+        bool expected = expectedState(index) == IGovernor.ProposalState.Succeeded;
    492  |+        (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    493  |+        (bool ok, bytes memory result) = _call(
    494  |+            CallKind.Queue,
    495  |+            actor(4),
    496  |+            address(governor),
    497  |+            abi.encodeCall(governor.queue, (targets, values, data, p.descriptionHash)),
    498  |+            expected
    499  |+        );
    500  |+        if (ok) {
    501  |+            _checkReturn(result, p.id);
    502  |+            p.queuedAt = block.timestamp;
    503  |+            p.eta = block.timestamp + 120;
    504  |+        }
    505  |+    }
    506  |+
    507  |+    function _execute(uint256 index, bool reachable) internal {
    508  |+        Proposal storage p = proposals[index];
    509  |+        bool validPath = expectedState(index) == IGovernor.ProposalState.Queued && p.eta != 0
    510  |+            && block.timestamp >= p.eta && p.queuedAt > p.deadline && p.tallies[1] + p.tallies[2] >= QUORUM
    511  |+            && p.tallies[1] > p.tallies[0];
    512  |+        bool expected = validPath && paymentsByRequest[p.request] == 0 && totalPaid <= totalFunded
    513  |+            && p.amount <= totalFunded - totalPaid;
    514  |+        bytes memory executionPayload;
    515  |+        bytes memory disbursement;
    516  |+        {
    517  |+            (address[] memory targets, uint256[] memory values, bytes[] memory data) = _action(p);
    518  |+            disbursement = data[0];
    519  |+            executionPayload = abi.encodeCall(governor.execute, (targets, values, data, p.descriptionHash));
    520  |+        }
    521  |+        vm.recordLogs();
    522  |+        (bool ok, bytes memory result) =
    523  |+            _call(CallKind.Execute, actor(4), address(governor), executionPayload, expected);
    524  |+        Vm.Log[] memory entries = vm.getRecordedLogs();
    525  |+        if (!ok) return;
    526  |+        _checkReturn(result, p.id);
    527  |+        _checkPaymentEvents(p, entries, disbursement);
    528  |+        p.executed = true;
    529  |+        p.executedAt = block.timestamp;
    530  |+        p.validExecution = validPath;
    531  |+        // Record the observed committed result even if it violated prediction.
    532  |+        // In particular, never condition this ghost history on paidRequests.
    533  |+        paymentsByRequest[p.request]++;
    534  |+        received[p.recipientIndex] += p.amount;
    535  |+        totalPaid += p.amount;
    536  |+        successfulExecutions++;
    537  |+        if (reachable) reachableExecutions++;
    538  |+        else spontaneousExecutions++;
    539  |+    }
    540  |+
    541  |+    function _checkPaymentEvents(Proposal storage p, Vm.Log[] memory entries, bytes memory payload) internal {
    542  |+        uint256 transfers;
    543  |+        uint256 disbursements;
    544  |+        uint256 timelockCalls;
    545  |+        for (uint256 i; i < entries.length; ++i) {
    546  |+            Vm.Log memory entry = entries[i];
    547  |+            if (entry.topics.length == 0) continue;
    548  |+            if (entry.emitter == address(bud) && entry.topics[0] == keccak256("Transfer(address,address,uint256)")) {
    549  |+                transfers++;
    550  |+                if (entry.topics.length != 3 || entry.data.length != 32) {
    551  |+                    unexpectedOutcome = true;
    552  |+                    continue;
    553  |+                }
    554  |+                if (
    555  |+                    entry.topics[1] != bytes32(uint256(uint160(address(treasury))))
    556  |+                        || entry.topics[2] != bytes32(uint256(uint160(recipient(p.recipientIndex))))
    557  |+                        || abi.decode(entry.data, (uint256)) != p.amount
    558  |+                ) unexpectedOutcome = true;
    559  |+            }
    560  |+            if (
    561  |+                entry.emitter == address(treasury)
    562  |+                    && entry.topics[0] == keccak256("BudgetDisbursed(bytes32,address,uint256)")
    563  |+            ) {
    564  |+                disbursements++;
    565  |+                if (entry.topics.length != 3 || entry.data.length != 32) {
    566  |+                    unexpectedOutcome = true;
    567  |+                    continue;
    568  |+                }
    569  |+                if (
    570  |+                    entry.topics[1] != requestId(p.request)
    571  |+                        || entry.topics[2] != bytes32(uint256(uint160(recipient(p.recipientIndex))))
    572  |+                        || abi.decode(entry.data, (uint256)) != p.amount
    573  |+                ) unexpectedOutcome = true;
    574  |+            }
    575  |+            if (
    576  |+                entry.emitter == address(timelock)
    577  |+                    && entry.topics[0] == keccak256("CallExecuted(bytes32,uint256,address,uint256,bytes)")
    578  |+            ) {
    579  |+                timelockCalls++;
    580  |+                if (
    581  |+                    entry.topics.length != 3 || entry.topics[1] != p.operation || entry.topics[2] != bytes32(0)
    582  |+                        || keccak256(entry.data) != keccak256(abi.encode(address(treasury), uint256(0), payload))
    583  |+                ) {
    584  |+                    unexpectedOutcome = true;
    585  |+                }
    586  |+            }
    587  |+        }
    588  |+        if (transfers != 1 || disbursements != 1 || timelockCalls != 1) unexpectedOutcome = true;
    589  |+    }
    590  |+
    591  |+    function _reachable(uint256 seed) internal {
    592  |+        reachableCalls++;
    593  |+        if (proposals.length >= MAX_PROPOSALS) return;
    594  |+        uint256 request = REQUEST_COUNT;
    595  |+        for (uint256 i; i < REQUEST_COUNT; ++i) {
    596  |+            uint256 candidate = (seed % REQUEST_COUNT + i) % REQUEST_COUNT;
    597  |+            if (paymentsByRequest[candidate] == 0) {
    598  |+                request = candidate;
    599  |+                break;
    600  |+            }
    601  |+        }
    602  |+        if (request == REQUEST_COUNT) return;
    603  |+        // EOA delegation, not fabricated voting state. Consolidation/transfer is
    604  |+        // unnecessary: one of five holders necessarily owns >=200 of 1000 GOV.
    605  |+        for (uint256 i; i < ACTOR_COUNT; ++i) {
    606  |+            _delegate(i, i);
    607  |+        }
    608  |+        _advance(block.timestamp + 1);
    609  |+        uint256 proposerIndex;
    610  |+        for (uint256 i = 1; i < ACTOR_COUNT; ++i) {
    611  |+            if (balances[i] > balances[proposerIndex]) proposerIndex = i;
    612  |+        }
    613  |+        (bool created, uint256 index) = _propose(proposerIndex, request, seed % RECIPIENT_COUNT, 1 ether);
    614  |+        if (!created) return;
    615  |+        _advance(proposals[index].snapshot + 1);
    616  |+        for (uint256 i; i < ACTOR_COUNT; ++i) {
    617  |+            _vote(index, i, 1);
    618  |+        }
    619  |+        _advance(proposals[index].deadline + 1);
    620  |+        _queue(index);
    621  |+        _advance(proposals[index].eta);
    622  |+        if (totalPaid <= totalFunded && totalFunded - totalPaid < 1 ether && totalFunded < 20_000 ether) {
    623  |+            uint256 shortfall = 1 ether - (totalFunded - totalPaid);
    624  |+            uint256 remaining = 20_000 ether - totalFunded;
    625  |+            _fund(shortfall < remaining ? shortfall : remaining);
    626  |+        }
    627  |+        _execute(index, true);
    628  |+    }
    629  |+}
    630  |+
    631  |+/// @dev Shared independent assertions, also used by the multi-step attack trace.
    632  |+abstract contract GovernanceOracleChecks is Test {
    633  |+    function _assertRequests(GovernanceOracleHandler h) internal view {
    634  |+        uint256 payments;
    635  |+        for (uint256 i; i < h.REQUEST_COUNT(); ++i) {
    636  |+            uint256 count = h.paymentsByRequest(i);
    637  |+            assertLe(count, 1, "INV01: repeated committed request payment");
    638  |+            assertEq(h.treasury().paidRequests(h.requestId(i)), count == 1, "INV01: paid flag/history mismatch");
    639  |+            payments += count;
    640  |+        }
    641  |+        assertEq(payments, h.successfulExecutions());
    642  |+        if (h.sequenceCalls() != 0) assertGe(payments, 1, "non-vacuity: no in-sequence execute");
    643  |+    }
    644  |+
    645  |+    function _assertPathAndRoles(GovernanceOracleHandler h) internal view {
    646  |+        assertFalse(h.unexpectedOutcome(), "SUT outcome/return/event differs from independent model");
    647  |+        assertEq(h.unauthorizedSuccesses(), 0, "INV02: direct authority bypass");
    648  |+        Treasury t = h.treasury();
    649  |+        TimelockController l = h.timelock();
    650  |+        BudgetGovernor g = h.governor();
    651  |+        // The universe includes every address to which these fixtures can grant
    652  |+        // authority, plus zero; AccessControl is not enumerable.
    653  |+        address[14] memory accounts = [
    654  |+            address(0),
    655  |+            h.bootstrap(),
    656  |+            h.funding(),
    657  |+            address(h),
    658  |+            address(t),
    659  |+            address(l),
    660  |+            address(g),
    661  |+            address(h.gov()),
    662  |+            address(h.bud()),
    663  |+            h.actor(0),
    664  |+            h.actor(1),
    665  |+            h.actor(2),
    666  |+            h.actor(3),
    667  |+            h.actor(4)
    668  |+        ];
    669  |+        for (uint256 i; i < accounts.length; ++i) {
    670  |+            _assertRoleHolder(t, l, g, accounts[i]);
    671  |+        }
    672  |+        for (uint256 i; i < h.RECIPIENT_COUNT(); ++i) {
    673  |+            _assertRoleHolder(t, l, g, h.recipient(i));
    674  |+        }
    675  |+        assertEq(address(g.token()), address(h.gov()));
    676  |+        assertEq(address(g.treasury()), address(t));
    677  |+        assertEq(g.timelock(), address(l));
    678  |+        assertEq(address(t.budgetToken()), address(h.bud()));
    679  |+        assertEq(l.getMinDelay(), 120);
    680  |+        assertEq(g.votingDelay(), 60);
    681  |+        assertEq(g.votingPeriod(), 300);
    682  |+        assertEq(g.proposalThreshold(), 50 ether);
    683  |+        assertEq(g.quorumNumerator(), 20);
    684  |+        for (uint256 i; i < h.proposalCount(); ++i) {
    685  |+            GovernanceOracleHandler.Proposal memory p = h.proposal(i);
    686  |+            assertEq(uint256(g.state(p.id)), uint256(h.expectedState(i)), "INV02: proposal state/history mismatch");
    687  |+            assertEq(g.proposalProposer(p.id), h.actor(p.proposerIndex));
    688  |+            assertEq(g.proposalSnapshot(p.id), p.snapshot);
    689  |+            assertEq(g.proposalDeadline(p.id), p.deadline);
    690  |+            assertEq(g.proposalEta(p.id), p.eta);
    691  |+            if (p.eta != 0) {
    692  |+                assertGt(p.queuedAt, p.deadline, "INV02: queue before deadline");
    693  |+                assertGe(p.tallies[1] + p.tallies[2], h.QUORUM());
    694  |+                assertGt(p.tallies[1], p.tallies[0]);
    695  |+                assertEq(p.eta, p.queuedAt + 120);
    696  |+                assertEq(l.getTimestamp(p.operation), p.executed ? 1 : p.eta, "INV02: retry changed operation");
    697  |+            } else {
    698  |+                assertFalse(l.isOperation(p.operation), "INV02: operation without Governor queue");
    699  |+            }
    700  |+            if (p.executed) {
    701  |+                assertTrue(p.validExecution, "INV02: payout lacked valid proposal/quorum/ETA");
    702  |+                assertGe(p.executedAt, p.eta);
    703  |+                assertTrue(l.isOperationDone(p.operation));
    704  |+                assertEq(h.paymentsByRequest(p.request), 1);
    705  |+            }
    706  |+        }
    707  |+    }
    708  |+
    709  |+    function _assertRoleHolder(Treasury t, TimelockController l, BudgetGovernor g, address account) internal view {
    710  |+        assertEq(t.hasRole(t.DEFAULT_ADMIN_ROLE(), account), account == address(l));
    711  |+        assertEq(t.hasRole(t.SPENDER_ROLE(), account), account == address(l));
    712  |+        assertEq(l.hasRole(l.DEFAULT_ADMIN_ROLE(), account), account == address(l));
    713  |+        assertEq(l.hasRole(l.PROPOSER_ROLE(), account), account == address(g));
    714  |+        assertEq(l.hasRole(l.EXECUTOR_ROLE(), account), account == address(g));
    715  |+        assertEq(l.hasRole(l.CANCELLER_ROLE(), account), account == address(g));
    716  |+    }
    717  |+
    718  |+    function _assertLedger(GovernanceOracleHandler h) internal view {
    719  |+        uint256 recipientBalances;
    720  |+        for (uint256 i; i < h.RECIPIENT_COUNT(); ++i) {
    721  |+            uint256 balance = h.bud().balanceOf(h.recipient(i));
    722  |+            assertEq(balance, h.received(i), "INV03: recipient ledger mismatch");
    723  |+            recipientBalances += balance;
    724  |+        }
    725  |+        assertEq(recipientBalances, h.totalPaid());
    726  |+        assertLe(h.totalPaid(), h.totalFunded());
    727  |+        assertEq(h.bud().balanceOf(address(h.treasury())) + h.totalPaid(), h.totalFunded());
    728  |+        assertEq(h.bud().balanceOf(h.funding()) + h.totalFunded(), 20_000 ether);
    729  |+        assertEq(h.bud().totalSupply(), 20_000 ether);
    730  |+        assertEq(
    731  |+            h.bud().balanceOf(h.funding()) + h.bud().balanceOf(address(h.treasury())) + recipientBalances, 20_000 ether
    732  |+        );
    733  |+    }
    734  |+
    735  |+    function _assertSnapshots(GovernanceOracleHandler h) internal view {
    736  |+        uint256[5] memory current = h.currentWeights();
    737  |+        uint256 balances;
    738  |+        for (uint256 i; i < h.ACTOR_COUNT(); ++i) {
    739  |+            assertEq(h.gov().balanceOf(h.actor(i)), h.balances(i));
    740  |+            assertEq(h.gov().getVotes(h.actor(i)), current[i]);
    741  |+            assertEq(
    742  |+                h.gov().delegates(h.actor(i)), h.delegates(i) == h.ACTOR_COUNT() ? address(0) : h.actor(h.delegates(i))
    743  |+            );
    744  |+            for (uint256 spender; spender < h.ACTOR_COUNT(); ++spender) {
    745  |+                assertEq(
    746  |+                    h.gov().allowance(h.actor(i), h.actor(spender)),
    747  |+                    h.allowances(i, spender),
    748  |+                    "INV04: allowance differs from independent approval/transferFrom history"
    749  |+                );
    750  |+            }
    751  |+            balances += h.balances(i);
    752  |+        }
    753  |+        assertEq(balances, h.SUPPLY());
    754  |+        assertEq(h.gov().totalSupply(), h.SUPPLY());
    755  |+        for (uint256 i; i < h.proposalCount(); ++i) {
    756  |+            GovernanceOracleHandler.Proposal memory p = h.proposal(i);
    757  |+            (uint256 againstVotes, uint256 forVotes, uint256 abstainVotes) = h.governor().proposalVotes(p.id);
    758  |+            assertEq(againstVotes, p.tallies[0]);
    759  |+            assertEq(forVotes, p.tallies[1]);
    760  |+            assertEq(abstainVotes, p.tallies[2]);
    761  |+            uint256 snapshotSupply;
    762  |+            for (uint256 voter; voter < h.ACTOR_COUNT(); ++voter) {
    763  |+                assertEq(h.governor().hasVoted(p.id, h.actor(voter)), (p.votedMask & (1 << voter)) != 0);
    764  |+                if (p.pinned) {
    765  |+                    assertEq(
    766  |+                        h.gov().getPastVotes(h.actor(voter), p.snapshot),
    767  |+                        p.weights[voter],
    768  |+                        "INV04: changed snapshot weight"
    769  |+                    );
    770  |+                    snapshotSupply += p.weights[voter];
    771  |+                }
    772  |+            }
    773  |+            if (p.pinned) {
    774  |+                assertEq(h.gov().getPastTotalSupply(p.snapshot), h.SUPPLY());
    775  |+                assertLe(snapshotSupply, h.SUPPLY()); // Undelegated supply need not have a vote.
    776  |+                assertLe(againstVotes + forVotes + abstainVotes, snapshotSupply, "INV04: snapshot votes reused");
    777  |+            }
    778  |+        }
    779  |+    }
    780  |+}
    781  |+
    782  |+/// @notice Local INV01-INV04 only; profile.ci provides the required 100 x 50.
    783  |+/// @dev Reachability is intentionally biased, not a liveness claim for every
    784  |+/// arbitrary EOA strategy. Unauthorized calls are bounded to the role universe.
    785  |+contract GovernanceInvariantTest is GovernanceOracleChecks {
    786  |+    GovernanceOracleHandler internal handler;
    787  |+
    788  |+    function setUp() public {
    789  |+        vm.warp(10_000);
    790  |+        handler = new GovernanceOracleHandler();
    791  |+        bytes4[] memory selectors = new bytes4[](14);
    792  |+        selectors[0] = GovernanceOracleHandler.lifecycle.selector;
    793  |+        selectors[1] = GovernanceOracleHandler.propose.selector;
    794  |+        selectors[2] = GovernanceOracleHandler.vote.selector;
    795  |+        selectors[3] = GovernanceOracleHandler.advance.selector;
    796  |+        selectors[4] = GovernanceOracleHandler.queue.selector;
    797  |+        selectors[5] = GovernanceOracleHandler.execute.selector;
    798  |+        selectors[6] = GovernanceOracleHandler.cancel.selector;
    799  |+        selectors[7] = GovernanceOracleHandler.fund.selector;
    800  |+        selectors[8] = GovernanceOracleHandler.transferGov.selector;
    801  |+        selectors[9] = GovernanceOracleHandler.delegateGov.selector;
    802  |+        selectors[10] = GovernanceOracleHandler.unauthorized.selector;
    803  |+        selectors[11] = GovernanceOracleHandler.tamper.selector;
    804  |+        selectors[12] = GovernanceOracleHandler.approveGov.selector;
    805  |+        selectors[13] = GovernanceOracleHandler.transferFromGov.selector;
    806  |+        targetContract(address(handler));
    807  |+        targetSelector(FuzzSelector({addr: address(handler), selectors: selectors}));
    808  |+    }
    809  |+
    810  |+    function invariant_INV01_requestPaymentsAreUniqueAcrossProposalsAndRetries() public view {
    811  |+        _assertRequests(handler);
    812  |+    }
    813  |+
    814  |+    function invariant_INV02_everyPayoutHasValidGovernanceAndFinalRoles() public view {
    815  |+        _assertPathAndRoles(handler);
    816  |+    }
    817  |+
    818  |+    function invariant_INV03_treasuryAndRecipientsMatchCommittedLedger() public view {
    819  |+        _assertLedger(handler);
    820  |+    }
    821  |+
    822  |+    function invariant_INV04_snapshotWeightsAndTalliesRemainIndependentOfTokenChanges() public view {
    823  |+        _assertSnapshots(handler);
    824  |+    }
    825  |+
    826  |+    function afterInvariant() public {
    827  |+        assertGt(handler.sequenceCalls(), 0, "empty campaign");
    828  |+        assertGt(handler.reachableExecutions(), 0, "no successful Governor execution inside sequence");
    829  |+        assertFalse(handler.unexpectedOutcome(), "sticky unexpected result");
    830  |+        emit log_named_uint("sequence actions", handler.sequenceCalls());
    831  |+        emit log_named_uint("reachable lifecycle calls", handler.reachableCalls());
    832  |+        emit log_named_uint("Governor execute successes", handler.successfulExecutions());
    833  |+        emit log_named_uint("unassisted execute successes", handler.spontaneousExecutions());
    834  |+        emit log_named_uint("execute reverts", handler.reverts(uint256(GovernanceOracleHandler.CallKind.Execute)));
    835  |+        emit log_named_uint("vote successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Vote)));
    836  |+        emit log_named_uint("queue successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Queue)));
    837  |+        emit log_named_uint("cancel successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Cancel)));
    838  |+        emit log_named_uint(
    839  |+            "unauthorized reverts", handler.reverts(uint256(GovernanceOracleHandler.CallKind.Unauthorized))
    840  |+        );
    841  |+        emit log_named_uint("approval successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.Approve)));
    842  |+        emit log_named_uint(
    843  |+            "transferFrom successes", handler.successes(uint256(GovernanceOracleHandler.CallKind.TransferFrom))
    844  |+        );
    845  |+        emit log_named_uint(
    846  |+            "transferFrom reverts", handler.reverts(uint256(GovernanceOracleHandler.CallKind.TransferFrom))
    847  |+        );
    848  |+        for (uint256 i; i < 8; ++i) {
    849  |+            emit log_named_uint(string.concat("model state visits ", vm.toString(i)), handler.stateVisits(i));
    850  |+        }
    851  |+        emit log_named_uint("total BUD funded", handler.totalFunded());
    852  |+        emit log_named_uint("total BUD paid", handler.totalPaid());
    853  |+    }
    854  |+}

