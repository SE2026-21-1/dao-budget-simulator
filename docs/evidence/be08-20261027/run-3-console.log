    77   |+
    78   |+        handler.advance(second.deadline + 1 - block.timestamp);
    79   |+        handler.queue(1);
    80   |+        handler.queue(2);
    81   |+        handler.queue(3);
    82   |+        second = handler.proposal(2);
    83   |+        uint256 originalEta = second.eta;
    84   |+        bytes32 originalOperation = second.operation;
    85   |+        handler.advance(120);
    86   |+
    87   |+        // Adversaries include the FORMER bootstrap; even a Ready operation may
    88   |+        // only execute through Governor, whose executor role is not open.
    89   |+        handler.unauthorized(2, 0, 2);
    90   |+        handler.unauthorized(5, 0, 2);
    91   |+        handler.unauthorized(8, 0, 2);
    92   |+        handler.execute(1);
    93   |+        assertEq(handler.bud().balanceOf(address(handler.treasury())), 2_999 ether);
    94   |+        uint256 failuresBefore = handler.reverts(uint256(GovernanceOracleHandler.CallKind.Execute));
    95   |+        handler.execute(2); // Oversubscription is discovered only at execution.
    96   |+        assertEq(handler.reverts(uint256(GovernanceOracleHandler.CallKind.Execute)), failuresBefore + 1);
    97   |+        assertEq(handler.paymentsByRequest(2), 0);
    98   |+        assertFalse(handler.treasury().paidRequests(handler.requestId(2)));
    99   |+        assertEq(uint256(handler.governor().state(second.id)), uint256(IGovernor.ProposalState.Queued));
    100  |+        assertTrue(handler.timelock().isOperationReady(originalOperation));
    101  |+        assertFalse(handler.timelock().isOperationDone(originalOperation));
    102  |+        assertEq(handler.governor().proposalEta(second.id), originalEta);
    103  |+        assertEq(handler.bud().balanceOf(handler.recipient(1)), 0);
