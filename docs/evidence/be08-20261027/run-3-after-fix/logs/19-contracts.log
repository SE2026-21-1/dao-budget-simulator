[stdout]     71   |+    function setUp() public {
[stdout]     72   |+        token = new BudgetToken(holder);
[stdout]     73   |+        treasury = new Treasury(address(token), admin);
[stdout]     74   |+        vm.prank(admin);
[stdout]     75   |+        treasury.grantRole(SPENDER, timelock);
