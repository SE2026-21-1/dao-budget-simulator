[stdout]     84   |+        uint256 recipientIndex = recipientSeed % RECIPIENT_COUNT;
[stdout]     85   |+        bool authorized = expectedSpender[callerIndex];
[stdout]     86   |+        // This prediction never reads Treasury.paidRequests or Treasury's balance.
[stdout]     87   |+        bool shouldSucceed = authorized && successfulPaymentsByRequest[requestIndex] == 0 && amount > 0
[stdout]     88   |+            && totalPaid <= totalFunded && amount <= totalFunded - totalPaid;
