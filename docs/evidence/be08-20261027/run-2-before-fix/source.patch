+  const currentProposals = filteredProposals.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
+
+  return (
+    <div>
+      <div className="page-heading">
+        <div>
+          <p className="page-heading__eyebrow">Đề xuất · Màn hình 02</p>
